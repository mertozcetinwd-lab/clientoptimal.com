      "css": ".ds-site-nav{display:flex;align-items:center;gap:1.5rem}.ds-nav-link{display:inline-flex;min-height:44px;align-items:center;color:var(--text-dim);font:400 .84rem/1.4 var(--font-body);text-decoration:none;transition:color var(--t-fast) var(--ease)}.ds-nav-link:hover,.ds-nav-link[aria-current=page]{color:var(--accent)}.ds-nav-link:focus-visible{outline:2px solid var(--accent);outline-offset:4px}"
    },
