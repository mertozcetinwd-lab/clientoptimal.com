      "name": "Primary Call-to-Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled azure action for the main next step.",
      "html": "<a class=\"ds-button-primary\" href=\"#\">Discuss a call flow <span aria-hidden=\"true\">↗</span></a>",
      "css": ".ds-button-primary{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:1.2rem;padding:.75rem 1.15rem;border:1px solid var(--accent-fill);background:var(--accent-fill);color:var(--accent-fill-ink);font:700 .92rem/1.2 var(--font-body);text-decoration:none;transition:filter var(--t-fast) var(--ease),transform var(--t-fast) var(--ease)}.ds-button-primary:hover{filter:brightness(1.08);transform:translateY(-1px)}.ds-button-primary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-button-primary:active{transform:translateY(0)}"
    },
