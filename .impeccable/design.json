      "html": "<li class=\"ds-route-stop\"><span class=\"ds-route-label\">01 / OPEN</span><h3>Say it is AI.</h3><p><b>Assistant</b><span>“I’m an AI assistant for the team.”</span></p></li>",
      "css": ".ds-route-stop{padding:0 1.5rem 1rem 0;border-inline-start:1px solid var(--hair-2)}.ds-route-label{color:var(--accent);font:500 .65rem/1.5 var(--font-mono);letter-spacing:.1em}.ds-route-stop h3{margin:.7rem 0 1rem;color:var(--text);font:650 1.6rem/1.05 var(--font-display);letter-spacing:-.04em}.ds-route-stop p{display:grid;gap:.3rem;color:var(--text-dim);font:400 .88rem/1.5 var(--font-body)}.ds-route-stop b{color:var(--muted);font:500 .63rem/1.5 var(--font-mono);letter-spacing:.08em;text-transform:uppercase}"
