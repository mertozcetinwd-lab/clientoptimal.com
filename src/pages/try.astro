---
// try.clientoptimal.com (Mert, 2026-11-09): the landing page for people who replied "interested"
// to an Explee email. One job: get them to hear the demo, see their own ROI, and book 30 minutes.
// The worker serves this page at the subdomain's root (src/worker.ts). noindex: it is a reply
// destination, not a search page.
import Base from '../layouts/Base.astro';
import PageHero from '../components/site/PageHero.astro';
import HowItWorks from '../components/site/HowItWorks.astro';
import ScaleTrust from '../components/site/ScaleTrust.astro';
import RoiCalculator from '../components/site/RoiCalculator.astro';
import FounderNote from '../components/site/FounderNote.astro';
import DemoCall from '../components/ui/DemoCall';

const BOOK = 'https://cal.com/mert-ozcetin/ai-voice-agent';
const steps = [
  ['We map your calls', 'Who rings straight through, what counts as urgent, your hours and the questions callers ask.'],
  ['We set it up and cover the setup costs', 'Your number stays the same. The voice AI is built, tested with you and switched on.'],
  ['We hand it off and keep it running', 'You get a text for every call and the customers who would have gone to voicemail.'],
];
---
<Base title="Hear the voice AI for yourself · Client Optimal" description="Voice AI that answers your calls, takes the details and texts them to you. Hear the demo, check your ROI and book 30 minutes." noindex>
  <PageHero>
    <div class="d-wrap lp-hero" id="main">
      <p class="d-pill d-in d-in--1"><span class="d-pulse" aria-hidden="true"></span>Thanks for replying. Here's the demo.</p>
      <h1 class="d-display d-in d-in--2 lp-h1"><span>Use voice AI to</span><span>streamline operations,</span><span class="d-grad">enhance customer service,</span><span>and scale effortlessly.</span></h1>
      <p class="lp-hear d-in d-in--3">Hear a demo for yourself.</p>
      <p class="d-lede d-in d-in--3">We take care of everything. We set it up, handle the costs, and hand it off to you.</p>
      <div class="lp-video d-in d-in--4">
        <video controls playsinline preload="metadata" poster="/video/voice-demo.jpg">
          <source src="/video/voice-demo.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="d-actions d-in d-in--5">
        <a class="d-btn d-btn--light" href="#book">Book 30 minutes</a>
        <a class="d-btn d-btn--glass" href="#roi">Check your ROI</a>
        <a class="d-btn d-btn--glass" href="#live">Talk to it live</a>
      </div>
    </div>
  </PageHero>

  <main>
    <section class="d-section" id="live" data-reveal>
      <div class="d-wrap lp-live">
        <div class="lp-live-copy">
          <p class="d-eyebrow">Try it now</p>
          <h2 class="d-display">Talk to it<br /><span class="d-grad">right here.</span></h2>
          <p>Tap the orb and tell it what kind of business you run. It plays your front desk, takes the details and shows you the text you would get. Prefer the phone? Call <a href="tel:+13526407955">(352) 640-7955</a>.</p>
          <p class="lp-fine">The browser demo sends your voice to a third-party voice AI provider, so don't share anything private. <a href="https://clientoptimal.com/privacy">Privacy</a></p>
        </div>
        <div class="lp-orb"><DemoCall client:only="react" /></div>
      </div>
    </section>

    <section class="d-section" style="padding-top:0" data-reveal>
      <div class="d-wrap">
        <div class="d-head">
          <div>
            <p class="d-eyebrow">How it works</p>
            <h2 class="d-display">Three steps.<br /><span class="d-grad">Nothing for you to build.</span></h2>
          </div>
        </div>
        <ol class="lp-steps">
          {steps.map(([t, d], i) => (<li><b>{i + 1}</b><h3>{t}</h3><p>{d}</p></li>))}
        </ol>
      </div>
    </section>

    <HowItWorks />
    <ScaleTrust />
    <RoiCalculator booking="#book" />
    <FounderNote link={false} />

    <section class="d-section" id="book" data-reveal>
      <div class="d-wrap">
        <div class="d-head">
          <div>
            <p class="d-eyebrow">Pick a time</p>
            <h2 class="d-display">Book 30 minutes.<br /><span class="d-grad">Bring your numbers.</span></h2>
          </div>
          <p>We'll look at how your calls work today, run your ROI together and tell you plainly if it isn't a fit. We only charge a fraction of what it brings back.</p>
        </div>
        <div class="lp-cal" id="cal-inline"></div>
        <p class="lp-fine">Calendar not loading? <a href={BOOK}>Open the booking page</a>.</p>
      </div>
    </section>
  </main>

  <script is:inline>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "book", { origin: "https://cal.com" });
    Cal.ns.book("inline", { elementOrSelector: "#cal-inline", calLink: "mert-ozcetin/ai-voice-agent", config: { layout: "month_view" } });
    Cal.ns.book("ui", { hideEventTypeDetails: false, layout: "month_view" });
  </script>
</Base>

<style>
  .lp-hero { display: grid; justify-items: center; text-align: center; padding: 12px 0 88px; }
  .lp-hero .d-pill { margin-bottom: 26px; }
  .lp-h1 { font-size: clamp(44px, 6.4vw, 104px); line-height: .9; margin: 0 0 34px; }
  .lp-h1 > span { display: block; }
  .lp-h1 .d-grad { color: var(--sky); }
  .lp-hear { margin: 0 0 12px; font: 500 13px/1 var(--mono); letter-spacing: .18em; text-transform: uppercase; color: var(--sky); }
  .lp-hero .d-lede { max-width: 34em; margin: 0 0 40px; line-height: 1.55; }
  .lp-hero .d-actions { margin-top: 32px; justify-content: center; }
  .lp-video { width: min(100%, 960px); border-radius: 22px; overflow: hidden; border: 1px solid rgba(165, 200, 255, .35); box-shadow: 0 0 0 6px rgba(63, 125, 255, .12), 0 40px 90px -40px rgba(63, 125, 255, .7); }
  .lp-video video { display: block; width: 100%; height: auto; background: #050f22; }
  .lp-live { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .lp-live-copy .d-eyebrow { color: var(--blue-ink); display: inline-flex; align-items: center; gap: 10px; }
  .lp-live-copy .d-eyebrow::before { content: ''; width: 18px; height: 1px; background: currentColor; }
  .lp-live-copy h2 { font-size: clamp(46px, 6.2vw, 88px); margin: 18px 0 28px; }
  .lp-live-copy p { color: var(--muted); font-size: 18px; line-height: 1.6; max-width: 30em; margin: 0 0 16px; }
  .lp-orb { display: grid; place-items: center; padding: 40px 0; }
  .lp-orb :global(.dc-halo), .lp-orb :global(.dc-aura), .lp-orb :global(.dc-ring) { display: none; }
  .lp-fine { font-size: 13.5px !important; color: var(--muted); }
  .lp-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .lp-steps li { padding: 26px; border: 1px solid var(--line); border-radius: var(--r-panel); background: #fff; }
  .lp-steps b { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--blue); color: #fff; font: 700 16px var(--mono); }
  .lp-steps h3 { margin: 16px 0 8px; font: 800 22px/1.1 var(--display); font-stretch: 80%; color: var(--ink); }
  .lp-steps p { margin: 0; color: var(--muted); }
  .lp-cal { min-height: 640px; border: 1px solid var(--line); border-radius: var(--r-panel); overflow: hidden; background: #fff; }
  @media (max-width: 900px) { .lp-live, .lp-steps { grid-template-columns: 1fr; } .lp-h1 > span { white-space: normal; } }
</style>
