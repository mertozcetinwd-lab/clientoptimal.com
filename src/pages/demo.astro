---
// THE DEMO PAGE. Built 2026-08-23.
//
// This is the landing page for the VSL link. It exists on THIS domain for one
// reason that is not aesthetic: the A2P 10DLC campaign registered against Client
// Optimal's EIN declares clientoptimal.com in its message flow and samples.
// Carriers check that links embedded in traffic match the registered brand, and
// an unknown third-party domain in cold SMS is a filtering trigger.
//
// So the video may be recorded and hosted anywhere. The LINK that goes out is
// always clientoptimal.com/demo.
//
// TO PUBLISH THE VIDEO:
//   1. Upload the recording (YouTube unlisted, or Loom).
//   2. Paste the embed URL into VIDEO_URL below.
//      YouTube: https://www.youtube-nocookie.com/embed/XXXXXXXXXXX
//      Loom:    https://www.loom.com/embed/XXXXXXXXXXXXXXXX
//   3. Deploy.
//
// Until VIDEO_URL is set the page shows a plain "coming shortly" state rather
// than a broken player. It is safe to deploy empty.
//
// VOICE: references/voice.md. Casual, direct, no hype, NO EM DASHES.
// HARD CONSTRAINT from site.js: zero clients, so nothing here may imply
// results, client counts, testimonials or track record.
import Base from '../layouts/Base.astro';
import { contact } from '../data/site.js';
import VoiceOrb from '../components/ui/VoiceOrb';

// Paste the embed URL here once the video is up. Empty string = placeholder state.
const VIDEO_URL = 'https://www.youtube-nocookie.com/embed/wDe3INaG8ZI?rel=0&playsinline=1';

// Optional: a direct file fallback if the video is self-hosted rather than embedded.
const VIDEO_FILE = '';
---

<Base
  title="AI call intake sample · Client Optimal"
  description="Review a sample AI voice interaction and the proposed inbound call intake flow. Audio processing and implementation limits are disclosed."
>
  <main class="demo">
    <header class="intro">
      <p class="eyebrow">Sample, not a client deployment</p>
      <h1>Hear a browser sample of AI call intake</h1>
      <p class="lede">
        The recording and interactive sample are demonstrations, not customer
        calls or proof of a client result. The interactive sample sends microphone
        audio to Retell AI. Read the notice and use fictional details only.
      </p>
    </header>

    <div class="interactive-demo">
      <VoiceOrb client:only="react" />
    </div>

    <div class="divider">
      <span>Or watch the recorded sample</span>
    </div>

    <div class="player">
      {VIDEO_URL ? (
        <div class="frame">
          <iframe
            src={VIDEO_URL}
            title="Illustrative AI call intake sample"
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      ) : VIDEO_FILE ? (
        <div class="frame">
          <video src={VIDEO_FILE} controls playsinline preload="metadata"></video>
        </div>
      ) : (
        <div class="soon">
          <p><strong>The video is going up shortly.</strong></p>
          <p>
            In the meantime, the short version is below, or just{' '}
            <a href={`tel:${contact.phone}`}>call {contact.phoneShow}</a> and ask.
          </p>
        </div>
      )}
    </div>

    <section class="how">
      <h2>What a scoped implementation would include</h2>
      <ol>
        <li>
          <b>Confirm the phone route</b>
          <span>The carrier, phone system, call-forwarding rules, coverage, and disable
            path are checked for the specific business before any number changes.</span>
        </li>
        <li>
          <b>Disclose that it is AI</b>
          <span>The approved opening identifies the assistant as AI and explains what
            the caller can ask for.</span>
        </li>
        <li>
          <b>Collect approved intake details</b>
          <span>For example, the caller's name, callback number, requested service,
            and location. The business decides which fields and answers are in scope.</span>
        </li>
        <li>
          <b>Hand exceptions to a person</b>
          <span>Urgent, unclear, or out-of-scope requests go to a person. The business sets the
            escalation route and callback commitment before launch.</span>
        </li>
      </ol>
    </section>

    <section class="straight">
      <h2>Limits for this draft</h2>
      <ul>
        <li><span><b>No emergency response or dispatch.</b> A voice agent is not a
          substitute for emergency services or a person who can take the call.</span></li>
        <li><span><b>No quotes, diagnoses, bookings, or promises.</b> Those are out of
          scope unless separately configured and verified in a written agreement.</span></li>
        <li><span><b>No assumed phone integration.</b> Provider, routing, notification
          destination, and operating costs are agreed before go-live.</span></li>
        <li><span><b>Human fallback is required.</b> The person, route, response time,
          and failure behavior need to be agreed before launch.</span></li>
        <li><span><b>Privacy settings need verification.</b> Recording, transcription,
          retention, and model-use settings are checked with the provider before live calls.</span></li>
      </ul>
    </section>

    <section class="cta">
      <h2>Want to scope your call flow?</h2>
      <p>
        Send your phone provider, call types, service area, and preferred human
        fallback route. Scope, price, timing, and support terms are confirmed
        before any live setup.
      </p>
      <p class="ctarow">
        <a class="btn" href={`tel:${contact.phone}`}>Call {contact.phoneShow}</a>
        <a class="btn ghost" href={`mailto:${contact.email}`}>Email instead</a>
      </p>
    </section>
  </main>
</Base>

<style>
  .demo {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 3.5rem) clamp(1rem, 4vw, 2rem) 5rem;
  }

  .intro {
    margin-bottom: 1.8rem;
  }
  .eyebrow {
    margin: 0 0 0.6rem;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.9rem, 5.5vw, 2.7rem);
    line-height: 1.06;
    letter-spacing: -0.033em;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: 34rem;
    color: var(--text-dim);
    font-size: 1.03rem;
  }

  .interactive-demo {
    margin-bottom: 2.2rem;
  }
  .divider {
    text-align: center;
    margin: 2.5rem 0 1.5rem;
    position: relative;
  }
  .divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--hair);
    z-index: 0;
  }
  .divider span {
    position: relative;
    z-index: 1;
    background: var(--bg);
    padding: 0 1rem;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* 16:9 without an aspect-ratio hack that collapses on older Safari */
  .frame {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    border-radius: 6px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 1px 2px #0a2f450d, 0 12px 34px #0a2f4514;
  }
  .frame iframe,
  .frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .soon {
    border: 1px dashed var(--hair);
    border-radius: 6px;
    padding: 1.6rem 1.3rem;
    text-align: center;
  }
  .soon p {
    margin: 0 0 0.4rem;
  }
  .soon p:last-child {
    margin: 0;
    font-size: 0.94rem;
    color: var(--text-dim);
  }

  section {
    margin-top: 2.8rem;
  }
  h2 {
    margin: 0 0 0.9rem;
    font-size: 1.28rem;
    letter-spacing: -0.022em;
  }

  .how ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .how li {
    counter-increment: step;
    position: relative;
    padding: 0.85rem 1rem 0.85rem 3.1rem;
    border: 1px solid var(--hair);
    border-radius: 5px;
  }
  .how li::before {
    content: counter(step);
    position: absolute;
    left: 0.9rem;
    top: 0.9rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.76rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .how b {
    display: block;
    margin-bottom: 0.15rem;
  }
  .how span {
    font-size: 0.94rem;
    color: var(--text-dim);
  }

  .straight ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .straight li {
    display: flex;
    gap: 0.7rem;
    font-size: 0.97rem;
  }
  .straight li::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 0.62rem;
  }

  .ctarow {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .btn {
    display: inline-block;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 4px;
    padding: 0.6rem 1.1rem;
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
  }
  .btn.ghost {
    background: none;
    color: var(--text);
    border-color: var(--hair);
  }
  .btn:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
</style>
