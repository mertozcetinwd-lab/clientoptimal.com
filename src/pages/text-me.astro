---
// THE SMS OPT-IN PAGE. Built 2026-08-21.
//
// This page exists for one reason: it is the consent mechanism cited in the
// A2P 10DLC campaign registration filed against Client Optimal's EIN. What is
// written here is a legal representation to carriers and to The Campaign
// Registry. Every element below is a REQUIREMENT, not a design choice.
//
// The four mandatory CTA disclosures (Telnyx 10DLC compliance guide):
//   1. Program / brand name          -> "Client Optimal"
//   2. Product description           -> what messages they will receive
//   3. Message frequency disclosure  -> "Message frequency may vary"
//   4. Cost disclosure               -> "Standard message and data rates may apply"
// Plus: consent + opt-out instructions + links to Privacy and Terms, and an
// UNCHECKED checkbox. A pre-ticked box is treated as invalid consent and is
// rejected on sight.
//
// RULES FOR ANYONE EDITING THIS FILE:
//   - The checkbox must NEVER default to checked.
//   - SMS consent must stay SEPARATE from any email or phone-call consent.
//     Bundled consent is non-compliant.
//   - This page must NOT gain a second phone-collecting form. Carriers want one
//     unambiguous opt-in path per page.
//   - Do not remove the disclosures to make the page prettier. They are why the
//     campaign is approvable.
//   - The words "including marketing messages" are LOAD-BEARING. Marketing is a
//     registered sub-use-case on the 10DLC campaign, and Telnyx names "marketing use
//     cases not explicitly mentioned in the opt-in language" as a rejection cause.
//     This sentence is also quoted verbatim in the campaign's Message Flow field, so
//     changing it here without changing it there creates a mismatch a reviewer checks.
//   - WHITESPACE: Astro collapses the newline between a text node and a following
//     tag, so a line ending in text before an element needs an explicit {' '}.
//     Without it the rendered copy reads "may vary.Standard" and "See ourPrivacy
//     Policy". Caught on the live page 2026-08-21.
//   - CONSENT_VERSION below is stored with every submission so we can prove
//     WHICH wording a person actually agreed to. Bump it whenever the consent
//     paragraph changes. Never edit the wording without bumping it.
import Base from '../layouts/Base.astro';
import { meta, contact } from '../data/site.js';

const CONSENT_VERSION = '2026-08-22.1';

// The Cloudflare Worker that logs consent. Same free-tier pattern as
// automations/og-worker/. Until it is deployed the form will not submit.
const ENDPOINT = 'https://consent.clientoptimal.com/optin';
---

<Base
  title={`Text me the demo · ${meta.name}`}
  description="Request a recorded sample of an AI voice interaction by email or, with separate consent, by text."
  noindex
>
  <section class="optin">
    <div class="wrap">
      <header class="head">
        <p class="eyebrow">{meta.name}</p>
        <h1 class="display title">Hear what it sounds like.</h1>
        <p class="lead">
          A short recorded sample of an AI voice interaction for a fictional
          service business. It is a demonstration, not a customer call or client
          result. The sample illustrates a possible intake flow; a real setup
          depends on the business's phone system and approved script.
        </p>
        <p class="lead" style="margin-top:.8rem">
          <strong>Your choice how you get it</strong>: tick the box for a text, or
          just leave your email instead. Either works, and you never have to
          agree to texts to see the demo.
        </p>
      </header>

      <form class="form" method="post" action={ENDPOINT}>
        <input type="hidden" name="consent_version" value={CONSENT_VERSION} />

        <label class="field">
          <span class="label">Your name</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label class="field">
          <span class="label">Business name</span>
          <input type="text" name="business" autocomplete="organization" />
        </label>

        <label class="field">
          <span class="label">Mobile number <span class="opt">(if you want it by text)</span></span>
          <input
            type="tel"
            name="phone"
            inputmode="tel"
            autocomplete="tel"
            placeholder="(352) 555-0142"
          />
        </label>

        <label class="field">
          <span class="label">Email <span class="opt">(if you would rather not be texted)</span></span>
          <input type="email" name="email" autocomplete="email" placeholder="you@yourcompany.com" />
        </label>

        {/* THE CONSENT BLOCK. Unchecked by default, SMS-only, all four
            disclosures present. Do not restructure.

            The checkbox is deliberately NOT `required`. The A2P checklist asks that a
            visitor be able to submit the form WITHOUT opting in -- a required box makes
            SMS consent a condition of getting the thing, which is the exact pattern the
            rule exists to stop. Leave it optional and let the email field carry the
            people who say no. */}
        <label class="consent">
          <input type="checkbox" name="sms_consent" value="yes" />
          <span>
            By checking this box and providing your phone number, you agree to
            receive text messages from <strong>Client Optimal</strong>,{' '}
            <strong>including marketing messages</strong>, about the AI
            call-answering demo you requested and follow-up about that
            service. <strong>Message frequency may vary.</strong>{' '}
            <strong>Standard message and data rates may apply.</strong>{' '}
            Reply <strong>STOP</strong> to opt out at any time, or{' '}
            <strong>HELP</strong> for help. See our{' '}
            <a href="/privacy">Privacy Policy</a> and{' '}
            <a href="/terms">Terms</a>.
          </span>
        </label>

        <button type="submit" class="submit">Text me the demo</button>

        <p class="fine">
          Consent to receive texts is not a condition of anything. Leave the box
          unticked and give us an email instead. We do not sell, rent, or share your
          number or your consent with anyone.
        </p>
      </form>

      <aside class="alt">
        <p>
          Questions first? Email{' '}
          <a href={`mailto:${contact.email}`}>{contact.email}</a> or see the{' '}
          <a href="/contact">contact page</a>.
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .optin { padding-block: clamp(3rem, 8vh, 5rem) 4rem; }

  .head {
    padding-bottom: 2.5rem;
    border-bottom: var(--hair-w) solid var(--hair);
    margin-bottom: 2.5rem;
  }
  .title { font-size: var(--step-h2); margin-block: 1rem 1rem; }
  .lead { color: var(--text-dim); max-width: var(--measure); }

  .form { max-width: 34rem; display: grid; gap: 1.25rem; }

  .field { display: grid; gap: 0.4rem; }
  .label {
    font-family: var(--font-mono);
    font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--muted);
  }
  .field input {
    background: transparent;
    border: var(--hair-w) solid var(--hair);
    border-radius: 2px;
    padding: 0.7rem 0.8rem;
    color: var(--text);
    font: inherit;
  }
  .field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* The consent block is deliberately NOT visually de-emphasised. Carriers
     require it to be "clearly and unambiguously displayed" -- shrinking it to
     grey 10px legalese is exactly what gets a campaign rejected. */
  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    padding: 1rem;
    border: var(--hair-w) solid var(--hair);
    border-radius: 2px;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-dim);
  }
  .consent input { margin-top: 0.25rem; width: 1rem; height: 1rem; }
  .consent strong { color: var(--text); font-weight: 600; }
  .consent a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .submit {
    justify-self: start;
    background: var(--text);
    color: var(--bg);
    border: 0;
    border-radius: 2px;
    padding: 0.75rem 1.4rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .submit:hover { opacity: 0.88; }

  .fine { font-size: 0.78rem; color: var(--muted); margin: 0; }
  .opt { color: var(--muted); text-transform: none; letter-spacing: 0; font-weight: 400; }

  .alt {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: var(--hair-w) solid var(--hair);
    max-width: var(--measure);
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .alt a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
</style>
