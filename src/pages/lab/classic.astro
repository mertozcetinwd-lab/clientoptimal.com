---
// Direction D, "Classic plus" (Mert, 2026-11-07: "incline way more towards the old website look",
// and A wasn't animated enough). This is the LIVE homepage, same layout, components and copy, with
// a motion layer on top: blueprint lines and a scan sweep over the navy hero, a dithered ASCII
// field, a filled supernova disc with a turning dial behind the orb, an animated call route, card
// borders that trace themselves on hover, FAQ underline sweeps, an ASCII burst in the closing panel
// and a moving voice wave on the footer. Everything new is scoped under .cx so nothing leaks into
// the real site. Never shipped: a production build redirects this page to /.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/site/PageHero.astro';
import TradesMarquee from '../../components/site/TradesMarquee.astro';
import HowItWorks from '../../components/site/HowItWorks.astro';
import TheRules from '../../components/site/TheRules.astro';
import CloseCta from '../../components/site/CloseCta.astro';
import DotField from '../../components/DotField.astro';
import DemoCall from '../../components/ui/DemoCall';
import { homeProblems, homeFaq } from '../../data/site.js';
if (import.meta.env.PROD) return Astro.redirect('/');

const arrow = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>';
const route = [
  { k: 'Source', name: 'Caller', i: 0 },
  { wire: 'dials', i: 0 },
  { k: 'Your line', name: 'Your number', i: 1 },
  { wire: 'forwards', i: 1 },
  { k: 'AI', name: 'Receptionist', i: 2, core: true },
  { wire: 'texts', i: 2 },
  { k: 'You', name: 'Text to you', i: 3 },
];
---

<Base title="D · Classic plus · Client Optimal lab" noindex>
  <div class="cx">
  <PageHero>
    <div class="cx-bp" aria-hidden="true">
      <pre class="cx-ascii" data-ascii="field" data-fps="4"></pre>
      <i class="cx-grid"></i><i class="cx-scan"></i>
      <i class="cx-reg cx-reg--tl"></i><i class="cx-reg cx-reg--tr"></i><i class="cx-reg cx-reg--bl"></i><i class="cx-reg cx-reg--br"></i>
    </div>
    <div class="d-wrap">
      <div class="d-hero-grid" id="main">
        <div class="d-hero-copy">
          <p class="d-pill d-in d-in--1"><span class="d-pulse" aria-hidden="true"></span>AI receptionist for the trades <b>Live</b></p>
          <h1 class="d-display d-in d-in--2"><span>Every call</span><span>answered.</span><span class="d-grad">Even on</span><span>a roof.</span></h1>
          <p class="d-lede d-in d-in--3">
            Client Optimal sets up an AI receptionist that answers your business calls, takes the
            details and <strong>texts them to you</strong>. People you know and real emergencies go
            straight through to your cell. Sales calls never reach you.
          </p>
          <div class="d-actions d-in d-in--4">
            <a class="d-btn d-btn--light" href="/demo">Hear the demo <Fragment set:html={arrow} /></a>
            <a class="d-btn d-btn--glass" href="#how">How it works</a>
          </div>
          <p class="d-hero-fine d-in d-in--5">
            Talk to it right here: tap the orb. It tells callers it's an AI, and the browser demo
            sends your voice to a third-party voice AI provider, so don't share anything private.{' '}
            <a href="/privacy">Privacy</a>
          </p>
        </div>
        <div class="cx-orb"><DemoCall client:only="react" max={340} /></div>
      </div>
    </div>
    <TradesMarquee />
  </PageHero>

  <main>
    <section class="d-section">
      <div class="d-wrap">
        <div class="d-head" data-reveal>
          <div>
            <p class="d-eyebrow">Sound familiar</p>
            <h2 class="d-display">The phone doesn't<br /><em>wait for you.</em></h2>
          </div>
          <p>You can't run a job and a phone line at the same time. Something gives, and usually it's the caller.</p>
        </div>
        <div class="d-cards">
          {homeProblems.map((c) => (
            <article class="d-card" data-reveal>
              <span class="d-order-no" aria-hidden="true">{c.idx}</span>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="d-shell cx-route-shell">
      <section class="d-panel cx-route-panel" data-reveal aria-labelledby="cx-route-h">
        <div class="d-mesh" aria-hidden="true"><i></i><i></i><i></i></div>
        <DotField />
        <div class="d-grain" aria-hidden="true"></div>
        <i class="cx-grid" aria-hidden="true"></i>
        <div class="d-wrap">
          <p class="d-eyebrow cx-route-eyebrow" id="cx-route-h">Where a call goes</p>
          <div class="cx-route" role="img" aria-label="A caller dials your number, it forwards to the receptionist, and you get a text. Known and urgent callers go straight to your cell.">
            {route.map((n) => n.wire
              ? <div class="cx-wire" style={`--i:${n.i}`}><span>{n.wire}</span></div>
              : <div class:list={['cx-node', n.core && 'cx-node--core']} style={`--i:${n.i}`}><small>{n.k}</small><b>{n.name}</b></div>)}
            <div class="cx-wire cx-wire--down" style="--i:2"><span>known · urgent</span></div>
            <div class="cx-node cx-node--cell" style="--i:3"><small>Straight through</small><b>Your cell</b></div>
          </div>
        </div>
      </section>
    </div>

    <HowItWorks />
    <TheRules />

    <section class="d-section" style="padding-top:0" id="faq">
      <div class="d-wrap">
        <div class="d-head" data-reveal>
          <div>
            <p class="d-eyebrow">Questions</p>
            <h2 class="d-display">Straight<br /><em>answers.</em></h2>
          </div>
          <p>If yours isn't here, book 15 minutes and ask it. You'll get a plain answer, including when it isn't a fit.</p>
        </div>
        <div class="d-faq" data-reveal>
          {homeFaq.map((f, i) => (
            <details open={i === 0}>
              <summary><span>{f.q}</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CloseCta />
  </main>
  </div>

  {import.meta.env.DEV && <nav class="cx-switch" aria-label="Design directions">
    <a href="/lab/classic">D · Classic plus</a><a href="/lab/drafting">A · Drafting</a><a href="/">Live home</a>
  </nav>}

  <script>
    import { mountAscii } from '../../lab/ascii.js';
    mountAscii();

    // 1. The orb's disc: filled supernova blue, a dithered core with sound rings, a turning dial.
    const orb = document.querySelector('.cx-orb');
    const addDisc = () => {
      const stage = orb?.querySelector('.dc-stage');
      if (!stage || stage.querySelector('.cx-disc')) return !!stage;
      const disc = document.createElement('div');
      disc.className = 'cx-disc';
      disc.setAttribute('aria-hidden', 'true');
      disc.innerHTML = '<pre class="cx-ascii" data-ascii="nova" data-fps="12"></pre><i class="cx-ticks"></i><i class="cx-ticks cx-ticks--in"></i><i class="cx-cross"></i>';
      stage.prepend(disc);
      mountAscii(disc);
      return true;
    };
    if (orb && !addDisc()) {
      const mo = new MutationObserver(() => { if (addDisc()) mo.disconnect(); });
      mo.observe(orb, { childList: true, subtree: true });
    }

    // 2. Borders that draw themselves on hover: an SVG outline on every card and work order.
    document.querySelectorAll<HTMLElement>('.cx .d-card, .cx .d-order, .cx .d-rule, .cx .d-rules > *').forEach((el) => {
      if (el.querySelector('.cx-trace')) return;
      el.insertAdjacentHTML('beforeend', '<svg class="cx-trace" aria-hidden="true" preserveAspectRatio="none"><rect x="1" y="1" width="100%" height="100%" pathLength="100"/></svg>');
    });

    // 3. An ASCII supernova behind the closing panel, and a voice wave across the footer.
    const close = document.querySelector('.d-shell--close .d-panel');
    close?.insertAdjacentHTML('afterbegin', '<div class="cx-burst" aria-hidden="true"><pre class="cx-ascii" data-ascii="burst" data-fps="10"></pre></div>');
    const foot = document.querySelector('.d-footer');
    foot?.insertAdjacentHTML('afterbegin', '<div class="cx-wave" aria-hidden="true"><pre class="cx-ascii" data-ascii="wave" data-fps="12"></pre></div>');
    if (close) mountAscii(close.querySelector('.cx-burst') as HTMLElement);
    if (foot) mountAscii(foot.querySelector('.cx-wave') as HTMLElement);
  </script>

  <style is:global>
    .cx { --nova: #4c8dff; --bp: #1446d8; }
    .cx-ascii { position: absolute; inset: 0; margin: 0; font: 400 11px/1.2 var(--mono); white-space: pre; overflow: hidden; pointer-events: none; }

    /* ---------- Hero: blueprint lines, a scan sweep, the ASCII field, registration marks ---------- */
    .cx-bp { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
    .cx-bp .cx-ascii { color: rgba(165,200,255,.16); }
    .cx-grid { position: absolute; inset: 0; pointer-events: none;
      background-image: linear-gradient(rgba(165,200,255,.09) 1px, transparent 1px), linear-gradient(90deg, rgba(165,200,255,.09) 1px, transparent 1px),
        linear-gradient(rgba(165,200,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(165,200,255,.04) 1px, transparent 1px);
      background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px; background-position: -1px -1px;
      -webkit-mask: radial-gradient(ellipse 80% 75% at 60% 45%, #000 30%, transparent 85%); mask: radial-gradient(ellipse 80% 75% at 60% 45%, #000 30%, transparent 85%);
      animation: cx-drift 40s linear infinite; }
    @keyframes cx-drift { to { background-position: 119px 119px, 119px 119px, 23px 23px, 23px 23px; } }
    .cx-scan { position: absolute; left: 0; right: 0; top: 0; height: 160px;
      background: linear-gradient(180deg, transparent, rgba(76,141,255,.10) 70%, rgba(165,200,255,.45) 99%, transparent);
      animation: cx-scan 7s cubic-bezier(.5,0,.5,1) infinite; }
    @keyframes cx-scan { 0% { transform: translateY(-170px); opacity: 0; } 10% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(110vh); opacity: 0; } }
    .cx-reg { position: absolute; width: 22px; height: 22px; opacity: .6; }
    .cx-reg::before, .cx-reg::after { content: ''; position: absolute; background: var(--sky); }
    .cx-reg::before { left: 50%; top: 0; bottom: 0; width: 1px; } .cx-reg::after { top: 50%; left: 0; right: 0; height: 1px; }
    .cx-reg--tl { left: 24px; top: 96px; } .cx-reg--tr { right: 24px; top: 96px; } .cx-reg--bl { left: 24px; bottom: 84px; } .cx-reg--br { right: 24px; bottom: 84px; }

    /* ---------- The orb on a filled supernova disc ---------- */
    .cx-orb { display: grid; justify-items: center; padding: 70px 0 10px; }
    .cx-disc { position: absolute; inset: -20%; z-index: 0; border-radius: 50%; overflow: hidden; pointer-events: none;
      background: radial-gradient(circle, #0a2a8f 0%, #0d35b8 32%, #1446d8 56%, #2f6bff 80%, #4c8dff 93%, #9cc4ff 100%);
      box-shadow: 0 0 0 1px rgba(165,200,255,.5), 0 0 0 14px rgba(165,200,255,.05), 0 0 0 15px rgba(165,200,255,.14), 0 0 120px -10px rgba(76,141,255,.75);
      animation: cx-breathe 6s ease-in-out infinite; }
    @keyframes cx-breathe { 50% { box-shadow: 0 0 0 1px rgba(165,200,255,.7), 0 0 0 18px rgba(165,200,255,.06), 0 0 0 19px rgba(165,200,255,.2), 0 0 160px 0 rgba(76,141,255,.9); } }
    .cx-disc .cx-ascii { font-size: 9px; line-height: 1.1; color: rgba(214,230,255,.7); }
    .cx-ticks { position: absolute; inset: 3%; border-radius: 50%; animation: dc-spin 80s linear infinite;
      background: repeating-conic-gradient(rgba(255,255,255,.7) 0 .35deg, transparent .35deg 5deg);
      -webkit-mask: radial-gradient(circle, transparent 95%, #000 95.5% 98%, transparent 98.5%); mask: radial-gradient(circle, transparent 95%, #000 95.5% 98%, transparent 98.5%); }
    .cx-ticks--in { inset: 9%; animation-direction: reverse; animation-duration: 50s; opacity: .5;
      background: repeating-conic-gradient(rgba(255,255,255,.8) 0 1deg, transparent 1deg 30deg); }
    .cx-cross { position: absolute; inset: 0;
      background: linear-gradient(rgba(205,224,255,.2), rgba(205,224,255,.2)) 50% 0 / 1px 100% no-repeat, linear-gradient(90deg, rgba(205,224,255,.2), rgba(205,224,255,.2)) 0 50% / 100% 1px no-repeat; }
    .cx-orb .dc-status, .cx-orb .dc-line { position: relative; z-index: 3; }
    .cx-orb .dc > .d-btn { position: relative; z-index: 4; margin-top: 104px; }
    .cx-orb .dc--connecting > .d-btn, .cx-orb .dc--listening > .d-btn, .cx-orb .dc--speaking > .d-btn { margin-top: 36px; }

    /* ---------- Call route panel ---------- */
    .cx-route-shell { margin-top: 0; }
    .cx-route-panel { padding: clamp(56px, 6vw, 88px) 0; }
    .cx-route-panel .cx-grid { -webkit-mask: none; mask: none; }
    .cx-route-eyebrow { color: var(--sky); display: inline-flex; align-items: center; gap: 10px; margin-bottom: 34px !important; }
    .cx-route-eyebrow::before { content: ''; width: 18px; height: 1px; background: currentColor; }
    .cx-route { --T: 5s; display: grid; grid-template-columns: auto 1fr auto 1fr auto 1fr auto; grid-template-rows: auto 70px auto; align-items: center; }
    .cx-node { position: relative; padding: 16px 20px; min-width: 150px; border: 1px solid rgba(165,200,255,.3); background: rgba(5,15,34,.75); backdrop-filter: blur(8px);
      animation: cx-light var(--T) cubic-bezier(.2,.7,.2,1) infinite; animation-delay: calc(var(--i) * 1s - .2s); }
    .cx-node small { display: block; font: 500 10.5px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--muted-dark); }
    .cx-node b { display: block; margin-top: 6px; font: 800 24px/1 var(--display); font-stretch: 76%; text-transform: uppercase; color: #fff; white-space: nowrap; }
    .cx-node--core { border-color: var(--nova); background: linear-gradient(180deg, #2f6bff, var(--bp)); animation-name: cx-light-core; }
    .cx-node--core small { color: #d6e5ff; }
    .cx-node--cell { grid-column: 5; grid-row: 3; justify-self: center; }
    @keyframes cx-light { 0%, 22% { border-color: var(--nova); box-shadow: 0 0 0 1px var(--nova), 0 0 40px -4px rgba(76,141,255,.9); transform: translateY(-2px); } 40%, 100% { box-shadow: none; transform: none; } }
    @keyframes cx-light-core { 0%, 22% { box-shadow: 0 0 0 1px #9cc4ff, 0 0 80px 0 rgba(76,141,255,1); transform: scale(1.04); } 40%, 100% { box-shadow: 0 0 40px -6px rgba(76,141,255,.8); transform: none; } }
    .cx-wire { position: relative; height: 1px; margin: 0 8px; background: repeating-linear-gradient(90deg, rgba(165,200,255,.55) 0 6px, transparent 6px 11px); background-size: 22px 1px; animation: cx-march 1.1s linear infinite; }
    .cx-wire span { position: absolute; left: 50%; bottom: 10px; transform: translateX(-50%); font: 500 10.5px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--sky); white-space: nowrap; }
    .cx-wire::before { content: ''; position: absolute; right: -2px; top: -4px; border: 4.5px solid transparent; border-left: 7px solid rgba(165,200,255,.85); border-right: 0; }
    .cx-wire::after { content: ''; position: absolute; top: -3px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: #fff; opacity: 0;
      box-shadow: 0 0 10px 3px rgba(76,141,255,.95), 0 0 26px 8px rgba(76,141,255,.5); animation: cx-run var(--T) linear infinite; animation-delay: calc(var(--i) * 1s); }
    @keyframes cx-march { to { background-position: 22px 0; } }
    @keyframes cx-run { 0% { left: 0; opacity: 1; } 15% { left: calc(100% - 7px); opacity: 1; } 16%, 100% { left: calc(100% - 7px); opacity: 0; } }
    .cx-wire--down { grid-column: 5; grid-row: 2; justify-self: center; width: 1px; height: 100%; margin: 0;
      background: repeating-linear-gradient(180deg, rgba(165,200,255,.55) 0 6px, transparent 6px 11px); background-size: 1px 22px; animation-name: cx-march-v; }
    .cx-wire--down span { left: 14px; bottom: auto; top: 50%; transform: translateY(-50%); }
    .cx-wire--down::before { right: auto; left: -4px; top: auto; bottom: -2px; border: 4.5px solid transparent; border-top: 7px solid rgba(165,200,255,.85); border-bottom: 0; }
    .cx-wire--down::after { left: -3px; top: 0; animation-name: cx-run-v; }
    @keyframes cx-march-v { to { background-position: 0 22px; } }
    @keyframes cx-run-v { 0% { top: 0; opacity: 1; } 15% { top: calc(100% - 7px); opacity: 1; } 16%, 100% { top: calc(100% - 7px); opacity: 0; } }

    /* ---------- Hover: borders trace themselves ---------- */
    .cx-trace { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 2; }
    .cx-trace rect { width: calc(100% - 2px); height: calc(100% - 2px); fill: none; stroke: var(--blue); stroke-width: 2; stroke-dasharray: 100; stroke-dashoffset: 100;
      transition: stroke-dashoffset .9s cubic-bezier(.2,.7,.2,1); }
    .cx .d-card:hover .cx-trace rect, .cx .d-order:hover .cx-trace rect, .cx .d-rule:hover .cx-trace rect, .cx .d-rules > *:hover .cx-trace rect { stroke-dashoffset: 0; }
    .cx .d-order, .cx .d-rule, .cx .d-rules > * { position: relative; }
    .cx .d-card .d-order-no { transition: transform .5s cubic-bezier(.2,.7,.2,1), color .3s; display: inline-block; }
    .cx .d-card:hover .d-order-no { transform: translateX(6px); }

    /* eyebrow rules draw in as each section reveals */
    .cx .d-head .d-eyebrow::before { width: 0; transition: width .8s cubic-bezier(.2,.7,.2,1) .2s; }
    .cx .d-head.is-in .d-eyebrow::before { width: 36px; }
    html:not(.js) .cx .d-head .d-eyebrow::before { width: 18px; }

    /* ---------- FAQ: an underline sweeps under the question ---------- */
    .cx .d-faq summary { position: relative; }
    .cx .d-faq summary::before { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: linear-gradient(90deg, var(--blue-ink), var(--nova));
      transform: scaleX(0); transform-origin: right; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
    .cx .d-faq summary:hover::before { transform: scaleX(1); transform-origin: left; }
    .cx .d-faq summary span { transition: transform .4s cubic-bezier(.2,.7,.2,1), color .3s; }
    .cx .d-faq summary:hover span { transform: translateX(10px); color: var(--blue-ink); }
    .cx .d-faq details[open] p { animation: cx-open .5s cubic-bezier(.2,.7,.2,1); }
    @keyframes cx-open { from { opacity: 0; transform: translateY(-8px); } }

    /* ---------- Close panel and footer ---------- */
    .d-shell--close .d-close { position: relative; z-index: 1; }
    .cx-burst { position: absolute; inset: 0 0 0 40%; z-index: 0; pointer-events: none;
      -webkit-mask: radial-gradient(ellipse at 60% 50%, #000 30%, transparent 75%); mask: radial-gradient(ellipse at 60% 50%, #000 30%, transparent 75%); }
    .cx-burst .cx-ascii { font-size: 10px; line-height: 1.1; color: rgba(165,200,255,.55); }
    body:has(.cx) .d-footer { position: relative; overflow: hidden; padding-top: 150px; }
    .cx-wave { position: absolute; left: 0; right: 0; top: 0; height: 110px; pointer-events: none; }
    .cx-wave .cx-ascii { font-size: 10px; line-height: 1.1; color: rgba(76,141,255,.6); }

    .cx-switch { position: fixed; z-index: 100; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 4px; padding: 5px; border-radius: 999px;
      background: rgba(10,14,22,.8); backdrop-filter: blur(10px); font: 500 12px/1 ui-monospace, monospace; }
    .cx-switch a { color: #cdd6e4; text-decoration: none; padding: 8px 12px; border-radius: 999px; white-space: nowrap; }
    .cx-switch a:hover { background: rgba(255,255,255,.12); color: #fff; }

    @media (max-width: 960px) {
      .cx-route { grid-template-columns: 1fr; grid-template-rows: none; justify-items: center; }
      .cx-route > * { grid-column: 1 !important; grid-row: auto !important; }
      .cx-node { width: min(260px, 100%); text-align: center; }
      .cx-wire, .cx-wire--down { width: 1px; height: 46px; margin: 0; background: repeating-linear-gradient(180deg, rgba(165,200,255,.55) 0 6px, transparent 6px 11px); background-size: 1px 22px; animation-name: cx-march-v; }
      .cx-wire span { left: 14px; bottom: auto; top: 50%; transform: translateY(-50%); }
      .cx-wire::before { right: auto; left: -4px; top: auto; bottom: -2px; border: 4.5px solid transparent; border-top: 7px solid rgba(165,200,255,.85); border-bottom: 0; }
      .cx-wire::after { left: -3px; top: 0; animation-name: cx-run-v; }
      .cx-orb { padding-top: 60px; }
      .cx-disc { inset: -13%; }
      .cx-orb .dc > .d-btn { margin-top: 70px; }
      .cx-burst { inset: 0; opacity: .5; }
      .cx-reg { display: none; }
      .cx-switch { left: 8px; right: 8px; transform: none; overflow-x: auto; font-size: 10.5px; }
    }
    @media (prefers-reduced-motion: reduce) { .cx *, .cx *::before, .cx *::after { animation: none !important; transition: none !important; } }
  </style>
</Base>
