    .dt-wire span { position: absolute; left: 50%; bottom: 8px; transform: translateX(-50%); font: 400 10.5px var(--anno); letter-spacing: .14em; text-transform: uppercase; color: #9cc0ff; white-space: nowrap; }
    .dt-wire::before { content: ''; position: absolute; right: -2px; top: -4px; border: 4.5px solid transparent; border-left: 7px solid rgba(156,192,255,.8); border-right: 0; }
    .dt-wire::after { content: ''; position: absolute; top: -3px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: #fff; opacity: 0;
      box-shadow: 0 0 10px 3px rgba(76,141,255,.95), 0 0 24px 6px rgba(76,141,255,.5); animation: dt-run var(--T) linear infinite; animation-delay: calc(var(--i) * 1s); }
    @keyframes dt-march { to { background-position: 22px 0; } }
