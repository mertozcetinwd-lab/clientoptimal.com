---
// Direction A, "Drafting table" (2026-11-07), refined the same day from Mert's notes: one aligned
// blueprint grid (the old fixed 120px grid slid against the scrolling 24px one, which is why the
// squares looked off), a solid supernova-blue disc behind the orb instead of an outline, pill buttons
// lifted on a blue glow like the live site's .d-btn, an animated call route, and the blue/black
// dithered-ASCII look of the AI Side Income ebooks (builds/ai-income-bundle/DESIGN.md, "Operator").
// Palette: pearl #F2F4F7, white #FFFFFF, blueprint #1446D8, hardcore blue #0A2A8F,
// supernova #4C8DFF, ink #05070D, silver #A9B3C1.
// Type: Big Shoulders Stencil Display (stencil lettering, as on drawings and job boxes),
// Big Shoulders Display (headings), Instrument Sans (body), B612 Mono (annotations; a cockpit face).
import Lab from '../../layouts/Lab.astro';
import DemoCall from '../../components/ui/DemoCall';
import TradesMarquee from '../../components/site/TradesMarquee.astro';
import { homeProblems, homeFaq, steps, rules, BOOKING_URL, DEMO_TEL } from '../../lab/content.js';
const fonts = 'family=Big+Shoulders+Stencil+Display:wght@800;900&family=Big+Shoulders+Display:wght@700;800&family=Instrument+Sans:wght@400;500;600&family=B612+Mono:wght@400;700';
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
const route = [
  { id: 'Src', name: 'Caller', i: 0 },
  { wire: 'dials', i: 0 },
  { id: 'Line', name: 'Your number', i: 1 },
  { wire: 'fwd', i: 1 },
  { id: 'AI', name: 'Receptionist', i: 2, core: true },
  { wire: 'text', i: 2 },
  { id: 'Out', name: 'Text to you', i: 3 },
];
---
<Lab title="A · Drafting table · Client Optimal lab" fonts={fonts} bodyClass="dt">
  <header class="dt-nav">
    <a class="dt-brand" href="/lab/drafting"><span class="dt-mark" aria-hidden="true"></span>Client Optimal</a>
    <nav><a href="#how">How it works</a><a href="#rules">The rules</a><a href="#faq">Questions</a></nav>
    <a class="d-btn dt-btn dt-btn--blue d-btn--sm" href={BOOKING_URL}>Book 15 min</a>
  </header>

  <main>
    <section class="dt-hero">
      <span class="dt-reg dt-reg--tl" aria-hidden="true"></span><span class="dt-reg dt-reg--tr" aria-hidden="true"></span>
      <span class="dt-reg dt-reg--bl" aria-hidden="true"></span><span class="dt-reg dt-reg--br" aria-hidden="true"></span>
      <div class="dt-sheet">
        <div class="dt-copy">
          <p class="dt-pill"><span class="dt-pulse" aria-hidden="true"></span>AI receptionist for the trades <b>Live</b></p>
          <h1 class="dt-h1"><span class="dt-ln">Every call</span><span class="dt-ln">answered.</span><span class="dt-ln dt-ln--blue">Even on a roof.</span></h1>
          <p class="dt-lede">Client Optimal sets up an AI receptionist that answers your business calls, takes the details and <strong>texts them to you</strong>. People you know and real emergencies go straight through to your cell. Sales calls never reach you.</p>
          <div class="dt-actions">
            <a class="d-btn dt-btn dt-btn--blue" href="/demo">Hear the demo <Fragment set:html={arrow} /></a>
            <a class="d-btn dt-btn dt-btn--paper" href="#how">How it works</a>
          </div>
          <p class="dt-fine">Tap the orb to talk to it. It tells callers it's an AI, and the browser demo sends your voice to a third-party voice AI provider, so don't share anything private. <a href="/privacy">Privacy</a></p>
        </div>

        <figure class="dt-detail" aria-label="Live demo: tap the orb to talk">
          <span class="dt-dim" aria-hidden="true"><i></i><b>Detail A · the receptionist</b><i></i></span>
          <DemoCall client:only="react" max={280} />
        </figure>
      </div>

      <dl class="dt-titleblock">
        <div><dt>Project</dt><dd>Every call answered</dd></div>
        <div><dt>Client</dt><dd>Home-service contractors</dd></div>
        <div><dt>Drawn by</dt><dd>Client Optimal LLC</dd></div>
        <div><dt>Location</dt><dd>Gainesville, Florida</dd></div>
      </dl>
    </section>

    <div class="dt-strip"><TradesMarquee /></div>

    <section class="dt-sec">
      <div class="dt-wrap">
        <header class="dt-head">
          <p class="dt-anno">Sound familiar</p>
          <h2>The phone doesn't <em>wait for you.</em></h2>
          <p>You can't run a job and a phone line at the same time. Something gives, and usually it's the caller.</p>
        </header>
        <div class="dt-grid3">
          {homeProblems.map((c, i) => (
            <article class="dt-card" tabindex="-1">
              <span class="dt-tag">Fault {['A', 'B', 'C'][i]}</span>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dt-sec dt-sec--ink" id="how">
      <pre class="dt-ascii dt-ascii--field" data-ascii="field" data-fps="3" aria-hidden="true"></pre>
      <div class="dt-wrap">
        <header class="dt-head">
          <p class="dt-anno">How it works</p>
          <h2>Your number. <em>Fewer interruptions.</em></h2>
          <p>It answers first, so you can stay on the job. You only stop for the people you know and the calls that really need you.</p>
        </header>

        <div class="dt-route" role="img" aria-label="Call route: a caller dials your number, it forwards to the receptionist, and you get a text. Known and urgent callers go straight to your cell.">
          {route.map((n) => n.wire
            ? <div class="dt-wire" style={`--i:${n.i}`}><span>{n.wire}</span></div>
            : <div class:list={['dt-node', n.core && 'dt-node--core']} style={`--i:${n.i}`}><small>{n.id}</small><b>{n.name}</b></div>)}
          <div class="dt-wire dt-wire--down" style="--i:2"><span>known · urgent</span></div>
          <div class="dt-node dt-node--cell" style="--i:3"><small>Bypass</small><b>Your cell</b></div>
        </div>

        <ol class="dt-steps">
          {steps.map((s) => (
            <li><h3>{s.title}</h3><p>{s.desc}</p><span class="dt-tag">{s.tag}</span></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="dt-sec" id="rules">
      <div class="dt-wrap">
        <header class="dt-head">
          <p class="dt-anno">Specification</p>
          <h2>No new number. <em>No pretending.</em></h2>
          <p>It's built around your phone and your rules. It sticks to what you approve and hands the rest to you.</p>
        </header>
        <table class="dt-spec">
          <tbody>
            {rules.map((r, i) => (<tr><th scope="row"><small>R{i + 1}</small>{r.title}</th><td>{r.desc}</td></tr>))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="dt-sec dt-sec--faq" id="faq">
      <div class="dt-wrap dt-faqwrap">
        <header class="dt-head">
          <p class="dt-anno">Questions</p>
          <h2>Straight <em>answers.</em></h2>
          <p>If yours isn't here, book 15 minutes and ask it. You'll get a plain answer, including when it isn't a fit.</p>
        </header>
        <div class="dt-faq">
          {homeFaq.map((f, i) => (<details open={i === 0}><summary><span>{f.q}</span></summary><p>{f.a}</p></details>))}
        </div>
      </div>
    </section>

    <section class="dt-close">
      <pre class="dt-ascii dt-ascii--sphere" data-ascii="sphere" data-fps="10" aria-hidden="true"></pre>
      <div class="dt-wrap dt-close-in">
        <p class="dt-anno">Next step</p>
        <h2>Want it on <em>your line?</em></h2>
        <p>15 minutes on Zoom with Mert. Bring how your calls work today and we'll see if it fits.</p>
        <div class="dt-actions">
          <a class="d-btn d-btn--light dt-btn" href={BOOKING_URL}>Book 15 minutes <Fragment set:html={arrow} /></a>
          <a class="d-btn d-btn--glass dt-btn" href={DEMO_TEL}>Call the demo line</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="dt-foot">
    <div class="dt-wavebox" aria-hidden="true"><pre class="dt-ascii dt-ascii--wave" data-ascii="wave" data-fps="10"></pre></div>
    <div class="dt-wrap">
      <div class="dt-foot-grid">
        <div class="dt-foot-brand">
          <a class="dt-brand" href="/lab/drafting"><span class="dt-mark" aria-hidden="true"></span>Client Optimal</a>
          <p>An AI receptionist for home-service contractors. It answers your calls, texts you the details, and puts the important ones through to you.</p>
        </div>
        <nav aria-label="Explore"><h2>Explore</h2><a href="/demo">Hear the demo</a><a href="/services">What you get</a><a href="/about">About Mert</a><a href="/text-me">Get texts from us</a></nav>
        <div><h2>Contact</h2><a href="mailto:mert@clientoptimal.com">mert@clientoptimal.com</a><a href={DEMO_TEL}>Demo line</a><p>Client Optimal LLC<br />1216 SW 2nd Ave, Gainesville, FL 32601</p></div>
      </div>
      <p class="dt-word" aria-hidden="true">Client Optimal</p>
      <div class="dt-foot-bottom">
        <span>© 2026 Client Optimal LLC</span>
        <span><a href="/privacy">Privacy</a><a href="/terms">Terms</a><span class="dt-sheetno">Sheet 1 of 1</span></span>
      </div>
    </div>
  </footer>

  <script>
    import { mountAscii } from '../../lab/ascii.js';
    mountAscii();
    // DemoCall mounts on the client, so the disc goes in once its stage exists: a filled
    // supernova-blue circle with a dithered ASCII core and a turning tick ring, behind the orb.
    const fig = document.querySelector('.dt-detail');
    const addDisc = () => {
      const stage = fig?.querySelector('.dc-stage');
      if (!stage || stage.querySelector('.dt-disc')) return !!stage;
      const disc = document.createElement('div');
      disc.className = 'dt-disc';
      disc.setAttribute('aria-hidden', 'true');
      disc.innerHTML = '<pre class="dt-ascii" data-ascii="nova" data-fps="12"></pre><i class="dt-ticks"></i><i class="dt-cross"></i>';
      stage.prepend(disc);
      mountAscii(disc);
      return true;
    };
    if (fig && !addDisc()) {
      const mo = new MutationObserver(() => { if (addDisc()) mo.disconnect(); });
      mo.observe(fig, { childList: true, subtree: true });
    }
  </script>

  <style is:global>
    body.dt { --pearl: #F2F4F7; --white: #fff; --bp: #1446D8; --hard: #0A2A8F; --nova: #4C8DFF; --ink: #05070D; --graph: #1d2330; --silver: #A9B3C1;
      --minor: rgba(20, 70, 216, .06); --major: rgba(20, 70, 216, .13); --line: rgba(20, 70, 216, .16);
      --stencil: 'Big Shoulders Stencil Display', 'Big Shoulders Display', 'Arial Narrow', sans-serif;
      --letter: 'Big Shoulders Display', 'Arial Narrow', sans-serif;
      --anno: 'B612 Mono', ui-monospace, monospace;
      --ease: cubic-bezier(.2, .7, .2, 1);
      margin: 0; color: var(--graph); font: 400 17px/1.6 'Instrument Sans', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
      /* ONE grid, one origin: majors every 5 minors (120 = 5 x 24), both scrolling with the page. */
      background-color: var(--pearl);
      background-image:
        linear-gradient(var(--major) 1px, transparent 1px), linear-gradient(90deg, var(--major) 1px, transparent 1px),
        linear-gradient(var(--minor) 1px, transparent 1px), linear-gradient(90deg, var(--minor) 1px, transparent 1px);
      background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
      background-position: -1px -1px; }
    html:has(body.dt) { background: #F2F4F7; color-scheme: light; }
    .dt main { overflow-x: clip; }
    .dt a { color: inherit; }
    .dt :focus-visible { outline: 2px solid var(--nova); outline-offset: 3px; }
    .dt-wrap { width: min(1240px, 100% - 48px); margin-inline: auto; position: relative; }
    .dt-anno { display: inline-flex; align-items: center; gap: 12px; font: 400 12px/1.4 var(--anno); letter-spacing: .16em; text-transform: uppercase; color: var(--bp); margin: 0 0 18px; }
    .dt-anno::before { content: ''; width: 28px; height: 1px; background: currentColor; }
    .dt h1, .dt h2, .dt h3 { font-family: var(--letter); text-transform: uppercase; color: var(--hard); margin: 0; letter-spacing: .01em; }
    .dt h2 { font-family: var(--stencil); font-weight: 900; font-size: clamp(44px, 5.6vw, 86px); line-height: .9; }
    .dt h2 em { font-style: normal; color: var(--bp); }
    .dt h3 { font-weight: 800; font-size: 27px; line-height: 1; }

    /* ---------- Buttons: the live site's pills (.d-btn: sheen sweep, arrow nudge) on a blue glow ---------- */
    .dt .dt-btn { font-family: 'Instrument Sans', sans-serif; font-size: 15.5px; }
    .dt .dt-btn:hover { transform: translateY(-2px); }
    .dt-btn--blue { color: #fff !important; background: linear-gradient(180deg, #2f6bff 0%, var(--bp) 100%);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.35), inset 0 -1px 0 rgba(3,11,36,.25), 0 1px 2px rgba(10,42,143,.3), 0 14px 30px -12px rgba(20,70,216,.75), 0 0 0 1px rgba(10,42,143,.35); }
    .dt-btn--blue:hover { box-shadow: inset 0 1px 0 rgba(255,255,255,.4), inset 0 -1px 0 rgba(3,11,36,.25), 0 2px 4px rgba(10,42,143,.25), 0 22px 44px -14px rgba(76,141,255,.95), 0 0 0 1px rgba(10,42,143,.4); }
    .dt-btn--paper { color: var(--hard) !important; background: rgba(255,255,255,.75); backdrop-filter: blur(10px);
      box-shadow: inset 0 -1px 0 rgba(10,20,36,.08), 0 0 0 1px rgba(20,70,216,.18), 0 12px 28px -14px rgba(20,70,216,.45); }
    .dt-btn--paper:hover { background: #fff; box-shadow: inset 0 -1px 0 rgba(10,20,36,.08), 0 0 0 1px rgba(20,70,216,.3), 0 20px 40px -16px rgba(20,70,216,.6); }
    .dt-btn--paper::after { background: linear-gradient(100deg, transparent 20%, rgba(76,141,255,.18) 50%, transparent 80%) !important; }

    /* ---------- Nav: clear glass ---------- */
    .dt-nav { position: sticky; top: 12px; z-index: 20; width: min(1240px, 100% - 24px); margin: 12px auto 0; display: flex; align-items: center; gap: 24px;
      padding: 8px 8px 8px 18px; border: 1px solid rgba(255,255,255,.8); border-radius: 999px; background: rgba(255,255,255,.6);
      backdrop-filter: blur(16px) saturate(1.5); box-shadow: 0 0 0 1px rgba(20,70,216,.1), 0 14px 34px -20px rgba(10,42,143,.45); }
    .dt-brand { font: 800 22px var(--letter); text-transform: uppercase; letter-spacing: .02em; text-decoration: none; color: var(--hard); display: inline-flex; gap: 10px; align-items: center; }
    .dt-mark { width: 18px; height: 18px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #9cc4ff, var(--nova) 35%, var(--bp) 70%, var(--hard));
      box-shadow: 0 0 0 3px rgba(20,70,216,.12), 0 0 14px rgba(76,141,255,.7); }
    .dt-nav nav { display: flex; gap: 6px; margin-left: auto; font-size: 15px; }
    .dt-nav nav a { position: relative; text-decoration: none; color: var(--graph); padding: 8px 12px; }
    .dt-nav nav a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 1px; background: var(--bp); transform: scaleX(0); transform-origin: right; transition: transform .4s var(--ease); }
    .dt-nav nav a:hover { color: var(--bp); }
    .dt-nav nav a:hover::after { transform: scaleX(1); transform-origin: left; }

    /* ---------- Hero sheet ---------- */
    .dt-hero { width: min(1240px, 100% - 48px); margin: 40px auto 56px; position: relative; border: 1.5px solid var(--hard);
      background: linear-gradient(160deg, rgba(255,255,255,.92) 0%, rgba(248,250,255,.85) 45%, rgba(226,235,255,.8) 100%);
      box-shadow: 0 50px 100px -60px rgba(10,42,143,.5); }
    .dt-hero::before { content: ''; position: absolute; inset: 8px; border: 1px solid var(--line); pointer-events: none; }
    .dt-reg { position: absolute; width: 22px; height: 22px; pointer-events: none; }
    .dt-reg::before, .dt-reg::after { content: ''; position: absolute; background: var(--bp); }
    .dt-reg::before { left: 50%; top: 0; bottom: 0; width: 1px; } .dt-reg::after { top: 50%; left: 0; right: 0; height: 1px; }
    .dt-reg--tl { left: -11px; top: -11px; } .dt-reg--tr { right: -11px; top: -11px; } .dt-reg--bl { left: -11px; bottom: -11px; } .dt-reg--br { right: -11px; bottom: -11px; }
    .dt-sheet { display: grid; grid-template-columns: 1.25fr 1fr; gap: 24px; padding: clamp(28px, 3.4vw, 52px) clamp(28px, 4vw, 60px) clamp(20px, 2.4vw, 32px); align-items: center; }
    .dt-pill { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px; padding: 7px 8px 7px 12px; border-radius: 999px; font: 500 13.5px 'Instrument Sans', sans-serif; color: var(--hard);
      background: rgba(255,255,255,.8); box-shadow: 0 0 0 1px rgba(20,70,216,.16), 0 8px 20px -12px rgba(20,70,216,.5); }
    .dt-pill b { font: 400 10.5px var(--anno); letter-spacing: .14em; text-transform: uppercase; color: #fff; background: var(--bp); padding: 4px 8px; border-radius: 999px; }
    .dt-pulse { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--nova); box-shadow: 0 0 10px 2px rgba(76,141,255,.8); }
    .dt-pulse::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1.5px solid var(--nova); animation: dt-ping 1.8s var(--ease) infinite; }
    @keyframes dt-ping { from { transform: scale(.6); opacity: 1; } to { transform: scale(2); opacity: 0; } }
    .dt-h1 { font-family: var(--stencil) !important; font-weight: 900; font-size: clamp(56px, 5.6vw, 92px); line-height: .88; margin-bottom: 26px !important; letter-spacing: .005em; }
    .dt-ln { display: block; white-space: nowrap; animation: dt-rise .9s var(--ease) both; }
    .dt-ln:nth-child(2) { animation-delay: .08s; } .dt-ln:nth-child(3) { animation-delay: .16s; }
    .dt-ln--blue { color: var(--bp); text-shadow: 0 0 30px rgba(76,141,255,.35); }
    @keyframes dt-rise { from { opacity: 0; transform: translateY(20px); clip-path: inset(0 0 100% 0); } to { opacity: 1; transform: none; clip-path: inset(-10% -5% -10% -5%); } }
    .dt-lede { font-size: clamp(17px, 1.3vw, 20px); max-width: 31em; margin: 0 0 28px; color: #3a4250; }
    .dt-lede strong { color: var(--hard); }
    .dt-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .dt-fine { font-size: 13px; color: #5d6676; margin: 24px 0 0; max-width: 34em; }

    /* the live orb sits on a solid supernova-blue disc; the button sits clear below it */
    .dt-detail { position: relative; margin: 0; display: grid; justify-items: center; padding: 84px 0 4px; }
    .dt-dim { position: absolute; left: 4%; right: 4%; top: 0; display: flex; align-items: center; gap: 12px; font: 400 11px var(--anno); letter-spacing: .14em; text-transform: uppercase; color: var(--bp); }
    .dt-dim i { flex: 1; height: 1px; background: var(--bp); position: relative; }
    .dt-dim i:first-child::before, .dt-dim i:last-child::after { content: ''; position: absolute; top: -5px; width: 1px; height: 11px; background: var(--bp); }
    .dt-dim i:first-child::before { left: 0; } .dt-dim i:last-child::after { right: 0; }
    .dt-detail .dc-halo { opacity: .55; }
    .dt-disc { position: absolute; inset: -22%; z-index: 0; border-radius: 50%; overflow: hidden; pointer-events: none;
      background: radial-gradient(circle at 50% 50%, #0a2a8f 0%, #0d35b8 30%, #1446D8 55%, #2f6bff 78%, #4C8DFF 92%, #8ab6ff 100%);
      box-shadow: 0 0 0 1.5px var(--hard), 0 0 0 10px rgba(255,255,255,.7), 0 0 0 11px var(--line), 0 50px 90px -30px rgba(20,70,216,.75), 0 0 80px -10px rgba(76,141,255,.55); }
    .dt-disc .dt-ascii { inset: 0; font-size: 9px; line-height: 1.1; color: rgba(214,230,255,.75); }
    .dt-ticks { position: absolute; inset: 3%; border-radius: 50%; animation: dc-spin 90s linear infinite;
      background: repeating-conic-gradient(rgba(255,255,255,.7) 0 .35deg, transparent .35deg 5deg);
      -webkit-mask: radial-gradient(circle, transparent 95%, #000 95.5% 98%, transparent 98.5%); mask: radial-gradient(circle, transparent 95%, #000 95.5% 98%, transparent 98.5%); }
    .dt-cross { position: absolute; inset: 0;
      background: linear-gradient(rgba(205,224,255,.22), rgba(205,224,255,.22)) 50% 0 / 1px 100% no-repeat, linear-gradient(90deg, rgba(205,224,255,.22), rgba(205,224,255,.22)) 0 50% / 100% 1px no-repeat; }
    .dt-detail .dc-status { position: relative; z-index: 3; margin-top: 18px; }
    .dt-detail .dc-line { position: relative; z-index: 3; color: #e6efff; }
    .dt-detail .dc > .d-btn { position: relative; z-index: 4; margin-top: 96px; color: #fff; background: linear-gradient(180deg, #2f6bff, var(--bp));
      box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 0 0 1px rgba(10,42,143,.35), 0 16px 34px -12px rgba(20,70,216,.8); font-family: 'Instrument Sans', sans-serif; }
    .dt-detail .dc > .d-btn:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 0 0 1px rgba(10,42,143,.4), 0 24px 46px -14px rgba(76,141,255,1); }
    .dt-detail .dc--connecting > .d-btn, .dt-detail .dc--listening > .d-btn, .dt-detail .dc--speaking > .d-btn { margin-top: 40px; }

    .dt-titleblock { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; border-top: 1.5px solid var(--hard); position: relative; background: rgba(255,255,255,.6); }
    .dt-titleblock div { padding: 12px 20px; border-right: 1px solid var(--line); }
    .dt-titleblock div:last-child { border-right: 0; }
    .dt-titleblock dt { font: 400 10px var(--anno); letter-spacing: .18em; text-transform: uppercase; color: #8590a3; }
    .dt-titleblock dd { margin: 2px 0 0; font: 800 19px var(--letter); text-transform: uppercase; letter-spacing: .02em; color: var(--hard); }

    /* ---------- Trades strip: the live site's navy dotted marquee ---------- */
    .dt-strip { background-color: #050f22; background-image: radial-gradient(rgba(165,200,255,.16) 1px, transparent 1.2px); background-size: 14px 14px; }
    .dt-strip .d-marquee { border-top: 0; padding: 22px 0; }
    .dt-strip .d-marquee ul { font-family: var(--anno); color: #a9b8cf; font-size: 12.5px; }

    /* ---------- Sections ---------- */
    .dt-sec { position: relative; padding: clamp(84px, 9vw, 140px) 0; }
    .dt-head { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 60px; align-items: end; margin-bottom: 52px; }
    .dt-head .dt-anno { grid-column: 1 / -1; margin: 0; }
    .dt-head > p:last-child { margin: 0; color: #4b5463; max-width: 30em; font-size: 18px; }
