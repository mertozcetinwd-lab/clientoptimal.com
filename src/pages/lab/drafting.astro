---
// Direction A, "Drafting table" (2026-11-07). The page is a blueprint sheet: pearl drafting paper,
// blueprint-blue linework, a title block, and the live orb drawn as the centre of a dimensioned
// detail, with callouts that say what it does. ASCII schematics carry the call route.
// Palette: pearl #F2F4F7, white #FFFFFF, blueprint #1446D8, hardcore blue #0A2A8F,
// supernova #4C8DFF, graphite #22272F, silver #A9B3C1.
// Type: Big Shoulders Display (lettering), Instrument Sans (body), JetBrains Mono (annotations).
import Lab from '../../layouts/Lab.astro';
import DemoCall from '../../components/ui/DemoCall';
import { homeProblems, homeFaq, steps, rules, BOOKING_URL, DEMO_TEL } from '../../lab/content.js';
const fonts = 'family=Big+Shoulders+Display:wght@600;800;900&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500';
---
<Lab title="A · Drafting table · Client Optimal lab" fonts={fonts} bodyClass="dt">
  <header class="dt-nav">
    <a class="dt-brand" href="/lab/drafting"><span class="dt-mark" aria-hidden="true">◎</span> Client Optimal</a>
    <nav><a href="#how">How it works</a><a href="#rules">The rules</a><a href="#faq">Questions</a></nav>
    <a class="dt-btn dt-btn--glow dt-btn--sm" href={BOOKING_URL}>Book 15 min</a>
  </header>

  <main>
    <section class="dt-hero">
      <div class="dt-sheet">
        <div class="dt-copy">
          <p class="dt-anno">DWG. 01 · AI receptionist for the trades <span class="dt-live">● live</span></p>
          <h1 class="dt-h1">Every call<br />answered.<br /><span>Even on a roof.</span></h1>
          <p class="dt-lede">Client Optimal sets up an AI receptionist that answers your business calls, takes the details and <strong>texts them to you</strong>. People you know and real emergencies go straight through to your cell. Sales calls never reach you.</p>
          <div class="dt-actions">
            <a class="dt-btn dt-btn--glow" href="/demo">Hear the demo <span aria-hidden="true">↗</span></a>
            <a class="dt-btn dt-btn--glass" href="#how">How it works</a>
          </div>
          <p class="dt-fine">Tap the orb to talk to it. It tells callers it's an AI, and the browser demo sends your voice to a third-party voice AI provider, so don't share anything private. <a href="/privacy">Privacy</a></p>
        </div>

        <figure class="dt-detail" aria-label="Live demo: tap the orb to talk">
          <div class="dt-lens">
            <pre class="dt-ascii" data-ascii="field" data-fps="4" aria-hidden="true"></pre>
            <div class="dt-cross" aria-hidden="true"></div>
            <DemoCall client:only="react" max={360} />
          </div>
          <span class="dt-dim dt-dim--h" aria-hidden="true"><i></i><b>Ø 360 · the receptionist</b><i></i></span>
          <span class="dt-call dt-call--in" aria-hidden="true">IN ── your business line</span>
          <span class="dt-call dt-call--out" aria-hidden="true">OUT ── a text to your cell</span>
          <figcaption>Detail A · live, tap to talk</figcaption>
        </figure>
      </div>

      <dl class="dt-titleblock">
        <div><dt>Project</dt><dd>Every call answered</dd></div>
        <div><dt>Client</dt><dd>Home-service contractors</dd></div>
        <div><dt>Drawn by</dt><dd>Client Optimal LLC</dd></div>
        <div><dt>Location</dt><dd>Gainesville, Florida</dd></div>
      </dl>
    </section>

    <section class="dt-sec">
      <div class="dt-wrap">
        <header class="dt-head">
          <p class="dt-anno">Sound familiar</p>
          <h2>The phone doesn't <em>wait for you.</em></h2>
          <p>You can't run a job and a phone line at the same time. Something gives, and usually it's the caller.</p>
        </header>
        <div class="dt-grid3">
          {homeProblems.map((c, i) => (
            <article class="dt-card">
              <span class="dt-tag">Fault {['A', 'B', 'C'][i]}</span>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dt-sec dt-sec--blue" id="how">
      <div class="dt-wrap">
        <header class="dt-head">
          <p class="dt-anno">How it works</p>
          <h2>Your number. <em>Fewer interruptions.</em></h2>
          <p>It answers first, so you can stay on the job. You only stop for the people you know and the calls that really need you.</p>
        </header>
<pre class="dt-schematic" aria-label="Call route: a caller dials your number, it forwards to the receptionist, and you get a text; known and urgent callers go to your cell.">
 CALLER ───► YOUR NUMBER ──fwd──► <b>RECEPTIONIST</b> ───► TEXT TO YOU
                                      │
                                      └── known · urgent ───► <b>YOUR CELL</b>
</pre>
        <ol class="dt-steps">
          {steps.map((s) => (
            <li><h3>{s.title}</h3><p>{s.desc}</p><span class="dt-tag">{s.tag}</span></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="dt-sec" id="rules">
      <div class="dt-wrap">
        <header class="dt-head">
          <p class="dt-anno">Specification</p>
          <h2>No new number. <em>No pretending.</em></h2>
          <p>It's built around your phone and your rules. It sticks to what you approve and hands the rest to you.</p>
        </header>
        <table class="dt-spec">
          <tbody>
            {rules.map((r) => (<tr><th scope="row">{r.title}</th><td>{r.desc}</td></tr>))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="dt-sec" id="faq">
      <div class="dt-wrap dt-faqwrap">
        <header class="dt-head">
          <p class="dt-anno">Questions</p>
          <h2>Straight <em>answers.</em></h2>
          <p>If yours isn't here, book 15 minutes and ask it. You'll get a plain answer, including when it isn't a fit.</p>
        </header>
        <div class="dt-faq">
          {homeFaq.map((f, i) => (<details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </div>
      </div>
    </section>

    <section class="dt-close">
      <pre class="dt-ascii dt-ascii--sphere" data-ascii="sphere" data-fps="10" aria-hidden="true"></pre>
      <div class="dt-wrap dt-close-in">
        <p class="dt-anno">Next step</p>
        <h2>Want it on <em>your line?</em></h2>
        <p>15 minutes on Zoom with Mert. Bring how your calls work today and we'll see if it fits.</p>
        <div class="dt-actions">
          <a class="dt-btn dt-btn--glow" href={BOOKING_URL}>Book 15 minutes <span aria-hidden="true">↗</span></a>
          <a class="dt-btn dt-btn--glass dt-btn--dark" href={DEMO_TEL}>Call the demo line</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="dt-foot">
    <span>© 2026 Client Optimal LLC · 1216 SW 2nd Ave, Gainesville, FL 32601</span>
    <span><a href="mailto:mert@clientoptimal.com">mert@clientoptimal.com</a> · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
  </footer>

  <script>
    import { mountAscii } from '../../lab/ascii.js';
    mountAscii();
  </script>

  <style is:global>
    body.dt { --pearl: #F2F4F7; --white: #fff; --bp: #1446D8; --hard: #0A2A8F; --nova: #4C8DFF; --graph: #22272F; --silver: #A9B3C1;
      --line: rgba(20, 70, 216, .14); --line2: rgba(20, 70, 216, .07);
      margin: 0; color: var(--graph); font: 400 17px/1.6 'Instrument Sans', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
      background-color: var(--pearl);
      background-image: linear-gradient(var(--line2) 1px, transparent 1px), linear-gradient(90deg, var(--line2) 1px, transparent 1px);
      background-size: 24px 24px; }
    html:has(body.dt) { background: #F2F4F7; color-scheme: light; }
    body.dt::before { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background: linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 120px 120px, linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 120px 120px; }
    .dt main, .dt-nav, .dt-foot { position: relative; z-index: 1; }
    .dt a { color: inherit; }
    .dt :focus-visible { outline: 2px solid var(--nova); outline-offset: 3px; }
    .dt-wrap { width: min(1240px, 100% - 48px); margin-inline: auto; }
    .dt-anno { font: 500 12px/1.4 'JetBrains Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--bp); margin: 0 0 18px; }
    .dt-live { color: #12a36a; margin-left: 6px; animation: dt-blink 2.4s infinite; }
    @keyframes dt-blink { 50% { opacity: .35; } }
    .dt h1, .dt h2, .dt h3 { font-family: 'Big Shoulders Display', 'Arial Narrow', sans-serif; text-transform: uppercase; color: var(--hard); margin: 0; letter-spacing: .005em; }
    .dt h2 { font-weight: 800; font-size: clamp(44px, 5.6vw, 84px); line-height: .92; }
    .dt h2 em, .dt-h1 span { font-style: normal; color: var(--bp); -webkit-text-stroke: 0; }
    .dt h3 { font-weight: 800; font-size: 26px; line-height: 1; }

    /* nav: clear glass */
    .dt-nav { position: sticky; top: 12px; z-index: 20; width: min(1240px, 100% - 24px); margin: 12px auto 0; display: flex; align-items: center; gap: 24px;
      padding: 10px 10px 10px 18px; border: 1px solid rgba(255,255,255,.7); border-radius: 14px; background: rgba(255,255,255,.55);
      backdrop-filter: blur(14px) saturate(1.4); box-shadow: 0 1px 0 rgba(20,70,216,.12), 0 12px 30px -18px rgba(10,42,143,.35); }
    .dt-brand { font: 800 22px 'Big Shoulders Display', sans-serif; text-transform: uppercase; text-decoration: none; color: var(--hard); display: flex; gap: 8px; align-items: center; }
    .dt-mark { color: var(--bp); }
    .dt-nav nav { display: flex; gap: 22px; margin-left: auto; font-size: 15px; }
    .dt-nav nav a { text-decoration: none; color: var(--graph); }
    .dt-nav nav a:hover { color: var(--bp); }

    /* buttons: glowing + clear glass */
    .dt-btn { --g: 0; display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 26px; border-radius: 12px; font: 600 16px 'Instrument Sans', sans-serif;
      text-decoration: none; transition: transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .25s, background .25s; }
    .dt-btn--sm { min-height: 42px; padding: 0 18px; font-size: 14.5px; }
    .dt-btn--glow { color: #fff !important; background: linear-gradient(180deg, #3f7cff, var(--bp)); border: 1px solid rgba(255,255,255,.35);
      box-shadow: 0 0 0 1px rgba(20,70,216,.4), 0 8px 24px -6px rgba(76,141,255,.75), 0 0 40px -8px rgba(76,141,255,.9), inset 0 1px 0 rgba(255,255,255,.4); }
    .dt-btn--glow:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px rgba(20,70,216,.5), 0 14px 34px -8px rgba(76,141,255,.9), 0 0 70px -6px rgba(76,141,255,1), inset 0 1px 0 rgba(255,255,255,.5); }
    .dt-btn--glass { color: var(--hard) !important; background: rgba(255,255,255,.45); border: 1px solid rgba(20,70,216,.25); backdrop-filter: blur(10px); }
    .dt-btn--glass:hover { background: rgba(255,255,255,.8); transform: translateY(-2px); }
    .dt-btn--dark { color: #fff !important; background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.3); }
    .dt-btn--dark:hover { background: rgba(255,255,255,.16); }

    /* hero sheet */
    .dt-hero { width: min(1240px, 100% - 48px); margin: 40px auto 0; border: 1.5px solid var(--hard); background: rgba(255,255,255,.55); position: relative; }
    .dt-hero::before { content: ''; position: absolute; inset: 8px; border: 1px solid var(--line); pointer-events: none; }
    .dt-sheet { display: grid; grid-template-columns: 1.05fr 1fr; gap: 40px; padding: clamp(28px, 4vw, 64px); align-items: center; }
    .dt-h1 { font-weight: 900; font-size: clamp(64px, 8.4vw, 132px); line-height: .86; margin-bottom: 26px !important;
      animation: dt-rise .9s cubic-bezier(.2,.7,.2,1) both; }
    .dt-h1 span { display: inline-block; color: var(--bp); text-shadow: 0 0 28px rgba(76,141,255,.35); }
    @keyframes dt-rise { from { opacity: 0; transform: translateY(18px); clip-path: inset(0 0 100% 0); } to { opacity: 1; transform: none; clip-path: inset(0 0 -10% 0); } }
    .dt-lede { font-size: clamp(17px, 1.3vw, 20px); max-width: 32em; margin: 0 0 30px; color: #3a4250; }
    .dt-lede strong { color: var(--hard); }
    .dt-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .dt-fine { font-size: 13px; color: #5d6676; margin: 22px 0 0; max-width: 34em; }

    .dt-detail { position: relative; margin: 0; padding: 34px 0 40px; }
    .dt-lens { position: relative; aspect-ratio: 1; display: grid; place-items: center; overflow: hidden; border-radius: 50%;
      background: radial-gradient(circle at 50% 45%, #0f2f8f, #061642 62%, #030b24); border: 1.5px solid var(--hard);
      box-shadow: 0 0 0 10px rgba(255,255,255,.6), 0 0 0 11px var(--line), 0 40px 80px -30px rgba(10,42,143,.6); }
    .dt-lens .dc-stage { z-index: 2; }
    .dt-lens .dc-line, .dt-lens .dc-status { position: relative; z-index: 3; }
    .dt-cross { position: absolute; inset: 0; pointer-events: none; z-index: 1;
      background: linear-gradient(rgba(165,200,255,.18), rgba(165,200,255,.18)) 50% 0 / 1px 100% no-repeat, linear-gradient(90deg, rgba(165,200,255,.18), rgba(165,200,255,.18)) 0 50% / 100% 1px no-repeat; }
    .dt-ascii { position: absolute; inset: 0; margin: 0; z-index: 0; font: 400 11px/1.25 'JetBrains Mono', monospace; color: rgba(165,200,255,.35); white-space: pre; overflow: hidden; pointer-events: none; }
    .dt-dim { position: absolute; left: 0; right: 0; top: 4px; display: flex; align-items: center; gap: 10px; font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--bp); }
    .dt-dim i { flex: 1; height: 1px; background: var(--bp); position: relative; }
    .dt-dim i:first-child::before, .dt-dim i:last-child::after { content: ''; position: absolute; top: -5px; width: 1px; height: 11px; background: var(--bp); }
    .dt-dim i:first-child::before { left: 0; } .dt-dim i:last-child::after { right: 0; }
    .dt-call { position: absolute; font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--hard);
      background: rgba(255,255,255,.85); padding: 5px 8px; border: 1px solid var(--line); backdrop-filter: blur(6px); z-index: 4; }
    .dt-call--in { left: -14px; top: 22%; } .dt-call--out { right: -14px; bottom: 22%; }
    .dt-detail figcaption { position: absolute; bottom: 0; left: 0; right: 0; text-align: center; font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--bp); }

    .dt-titleblock { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; border-top: 1.5px solid var(--hard); }
    .dt-titleblock div { padding: 12px 18px; border-right: 1px solid var(--line); }
    .dt-titleblock div:last-child { border-right: 0; }
    .dt-titleblock dt { font: 500 10px 'JetBrains Mono', monospace; letter-spacing: .16em; text-transform: uppercase; color: var(--silver); }
    .dt-titleblock dd { margin: 2px 0 0; font: 800 18px 'Big Shoulders Display', sans-serif; text-transform: uppercase; color: var(--hard); }

    /* sections */
    .dt-sec { padding: clamp(80px, 9vw, 140px) 0; }
    .dt-head { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 60px; align-items: end; margin-bottom: 48px; }
    .dt-head .dt-anno { grid-column: 1 / -1; margin: 0; }
    .dt-head > p:last-child { margin: 0; color: #4b5463; max-width: 30em; font-size: 18px; }
    .dt-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .dt-card { position: relative; padding: 28px; background: rgba(255,255,255,.6); border: 1px solid rgba(20,70,216,.22); backdrop-filter: blur(8px);
      transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s; }
    .dt-card::before, .dt-card::after { content: ''; position: absolute; width: 14px; height: 14px; border: 1.5px solid var(--bp); }
    .dt-card::before { top: -1px; left: -1px; border-right: 0; border-bottom: 0; } .dt-card::after { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
    .dt-card:hover { transform: translateY(-4px); box-shadow: 0 24px 50px -30px rgba(10,42,143,.5); }
    .dt-card h3 { margin: 18px 0 10px; } .dt-card p { margin: 0; color: #4b5463; font-size: 16px; }
    .dt-tag { display: inline-block; font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--bp); border: 1px solid var(--line); padding: 4px 8px; background: rgba(255,255,255,.6); }

    .dt-sec--blue { background: var(--hard); color: #dbe6ff; position: relative; overflow: hidden;
      background-image: linear-gradient(rgba(255,255,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.07) 1px, transparent 1px);
      background-size: 32px 32px; }
    .dt-sec--blue h2, .dt-sec--blue h3 { color: #fff; } .dt-sec--blue h2 em { color: #9cc0ff; }
    .dt-sec--blue .dt-anno { color: #9cc0ff; } .dt-sec--blue .dt-head > p:last-child { color: #b9c9ec; }
    .dt-schematic { font: 400 clamp(11px, 1.15vw, 16px)/1.7 'JetBrains Mono', monospace; color: #9cc0ff; margin: 0 0 48px; padding: 28px; overflow-x: auto;
      border: 1px dashed rgba(156,192,255,.4); background: rgba(3,11,36,.35); }
    .dt-schematic b { color: #fff; font-weight: 500; text-shadow: 0 0 14px rgba(76,141,255,.9); }
    .dt-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; counter-reset: s; }
    .dt-steps li { counter-increment: s; padding: 28px; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.06); backdrop-filter: blur(8px); }
    .dt-steps li::before { content: 'Step 0' counter(s); font: 500 11px 'JetBrains Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: #9cc0ff; }
    .dt-steps h3 { margin: 14px 0 10px; } .dt-steps p { margin: 0 0 18px; color: #c4d2f2; font-size: 16px; }
    .dt-steps .dt-tag { background: transparent; border-color: rgba(156,192,255,.35); color: #9cc0ff; }

    .dt-spec { width: 100%; border-collapse: collapse; border: 1.5px solid var(--hard); background: rgba(255,255,255,.6); }
    .dt-spec th, .dt-spec td { padding: 22px 26px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
    .dt-spec th { width: 34%; font: 800 26px 'Big Shoulders Display', sans-serif; text-transform: uppercase; color: var(--hard); border-right: 1px solid var(--line); }
    .dt-spec td { color: #3a4250; font-size: 17px; }

    .dt-faq details { border-top: 1px solid rgba(20,70,216,.22); }
    .dt-faq details:last-child { border-bottom: 1px solid rgba(20,70,216,.22); }
    .dt-faq summary { cursor: pointer; list-style: none; padding: 22px 0; font: 800 24px 'Big Shoulders Display', sans-serif; text-transform: uppercase; color: var(--hard); display: flex; justify-content: space-between; gap: 20px; }
    .dt-faq summary::after { content: '+'; font-family: 'JetBrains Mono', monospace; color: var(--bp); transition: transform .3s; }
    .dt-faq details[open] summary::after { transform: rotate(45deg); }
    .dt-faq details p { margin: 0 0 24px; color: #4b5463; max-width: 62ch; }

    .dt-close { position: relative; overflow: hidden; background: radial-gradient(ellipse at 70% 50%, #10328f, #050f30 70%); color: #dbe6ff; padding: clamp(90px, 10vw, 160px) 0; }
    .dt-ascii--sphere { inset: 0 0 0 40%; font-size: 9px; line-height: 1.1; color: rgba(156,192,255,.55); text-shadow: 0 0 12px rgba(76,141,255,.6); }
    .dt-close-in { position: relative; z-index: 1; }
    .dt-close h2 { color: #fff; font-size: clamp(54px, 7vw, 112px); } .dt-close h2 em { color: #9cc0ff; }
    .dt-close .dt-anno { color: #9cc0ff; }
    .dt-close p:not(.dt-anno) { max-width: 26em; color: #b9c9ec; font-size: 18px; margin: 18px 0 30px; }
    .dt-foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 26px max(24px, calc((100% - 1240px) / 2)) 80px; background: #030b24; color: #8e9cbd; font: 400 13px 'JetBrains Mono', monospace; }

    @media (max-width: 960px) {
      .dt-sheet, .dt-head, .dt-grid3, .dt-steps { grid-template-columns: 1fr; }
      .dt-titleblock { grid-template-columns: 1fr 1fr; }
      .dt-nav nav { display: none; }
      .dt-detail { max-width: 460px; margin-inline: auto; width: 100%; }
      .dt-call--in { left: 0; } .dt-call--out { right: 0; }
      .dt-ascii--sphere { inset: 0; opacity: .5; }
      .dt-spec th { width: 40%; font-size: 21px; } .dt-spec th, .dt-spec td { padding: 16px; }
    }
    @media (prefers-reduced-motion: reduce) { .dt *, .dt *::before { animation: none !important; transition: none !important; } }
  </style>
</Lab>
