    /* ---------- How it works: ink + cobalt, the ebook's dark pages ---------- */
    .dt-sec--ink { background: radial-gradient(ellipse 80% 70% at 85% 0%, rgba(20,70,216,.45), transparent 60%), radial-gradient(ellipse 60% 60% at 0% 100%, rgba(20,70,216,.25), transparent 60%), var(--ink);
