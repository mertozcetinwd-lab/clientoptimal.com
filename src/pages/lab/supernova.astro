---
// Direction B, "Supernova" (2026-11-07). A cyanotype night: hardcore blue print with white
// linework, and the orb as the core of a live ASCII supernova that fills the hero. Clear glass
// panels, glowing buttons with a moving edge, one cinematic moment and quiet sections after it.
// Palette: hardcore blue #04143F, print blue #0B2C8A, supernova #5B9BFF, ice #CFE0FF,
// pearl #F4F6FA, silver #9AA6BA.
// Type: Unbounded (display, used sparingly), Manrope (body), IBM Plex Mono (annotations).
import Lab from '../../layouts/Lab.astro';
import DemoCall from '../../components/ui/DemoCall';
import { homeProblems, homeFaq, steps, rules, sampleText, BOOKING_URL, DEMO_TEL } from '../../lab/content.js';
const fonts = 'family=Unbounded:wght@500;700;800&family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500';
---
<Lab title="B · Supernova · Client Optimal lab" fonts={fonts} bodyClass="sn">
  <header class="sn-nav">
    <a class="sn-brand" href="/lab/supernova"><span aria-hidden="true">✳</span> Client Optimal</a>
    <nav><a href="#how">How it works</a><a href="#rules">Rules</a><a href="#faq">Questions</a></nav>
    <a class="sn-btn sn-btn--glow sn-btn--sm" href={BOOKING_URL}><span>Book 15 min</span></a>
  </header>

  <main>
    <section class="sn-hero">
      <pre class="sn-burst" data-ascii="burst" data-fps="14" aria-hidden="true"></pre>
      <div class="sn-vignette" aria-hidden="true"></div>
      <div class="sn-hero-in">
        <p class="sn-anno sn-rise" style="--d:.05s">AI receptionist for the trades · <b>live</b></p>
        <h1 class="sn-h1 sn-rise" style="--d:.15s">Every call answered.<br /><em>Even on a roof.</em></h1>
        <div class="sn-core sn-rise" style="--d:.3s"><DemoCall client:only="react" max={300} /></div>
        <p class="sn-lede sn-rise" style="--d:.45s">An AI receptionist that answers your business calls, takes the details and texts them to you. People you know and real emergencies go straight to your cell. Sales calls never reach you.</p>
        <div class="sn-actions sn-rise" style="--d:.55s">
          <a class="sn-btn sn-btn--glow" href="/demo"><span>Hear the demo ↗</span></a>
          <a class="sn-btn sn-btn--glass" href="#how">How it works</a>
        </div>
        <p class="sn-fine">Tap the orb to talk to it. It says it's an AI, and the browser demo sends your voice to a third-party voice AI provider, so don't share anything private. <a href="/privacy">Privacy</a></p>
      </div>
    </section>

    <section class="sn-sec">
      <div class="sn-wrap">
        <header class="sn-head">
          <p class="sn-anno">Sound familiar</p>
          <h2>The phone doesn't wait for you.</h2>
          <p>You can't run a job and a phone line at the same time. Something gives, and usually it's the caller.</p>
        </header>
        <div class="sn-grid3">
          {homeProblems.map((c) => (
            <article class="sn-glass"><h3>{c.title}</h3><p>{c.desc}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="sn-sec sn-sec--how" id="how">
      <div class="sn-wrap sn-how">
        <div>
          <header class="sn-head sn-head--stack">
            <p class="sn-anno">How it works</p>
            <h2>Your number. Fewer interruptions.</h2>
          </header>
          <ol class="sn-steps">
            {steps.map((s) => (<li><h3>{s.title}</h3><p>{s.desc}</p><span>{s.tag}</span></li>))}
          </ol>
        </div>
        <figure class="sn-phone" aria-label="Example text message">
          <div class="sn-phone-glass">
            <p class="sn-anno">Messages · now</p>
            <p class="sn-msg-t">{sampleText.title}</p>
            <p class="sn-msg-b">{sampleText.body}</p>
          </div>
          <figcaption>Example only. The real text uses what your caller said.</figcaption>
        </figure>
      </div>
    </section>

    <section class="sn-sec" id="rules">
      <div class="sn-wrap">
        <header class="sn-head">
          <p class="sn-anno">The rules it follows</p>
          <h2>No new number. No pretending.</h2>
          <p>It sticks to what you approve and hands the rest to you.</p>
        </header>
        <div class="sn-rules">
          {rules.map((r) => (<div class="sn-rule"><h3>{r.title}</h3><p>{r.desc}</p></div>))}
        </div>
      </div>
    </section>

    <section class="sn-sec" id="faq">
      <div class="sn-wrap sn-faqwrap">
        <header class="sn-head sn-head--stack">
          <p class="sn-anno">Questions</p>
          <h2>Straight answers.</h2>
          <p>If yours isn't here, book 15 minutes and ask it.</p>
        </header>
        <div class="sn-faq">
          {homeFaq.map((f, i) => (<details open={i === 0}><summary>{f.q}</summary><p set:html={f.a} /></details>))}
        </div>
      </div>
    </section>

    <section class="sn-close">
      <pre class="sn-burst sn-burst--small" data-ascii="burst" data-fps="10" aria-hidden="true"></pre>
      <div class="sn-close-in">
        <p class="sn-anno">Next step</p>
        <h2>Want it on your line?</h2>
        <p>15 minutes on Zoom with Mert. Bring how your calls work today and we'll see if it fits.</p>
        <div class="sn-actions">
          <a class="sn-btn sn-btn--glow" href={BOOKING_URL}><span>Book 15 minutes ↗</span></a>
          <a class="sn-btn sn-btn--glass" href={DEMO_TEL}>Call the demo line</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="sn-foot">
    <span>© 2026 Client Optimal LLC · Gainesville, Florida</span>
    <span><a href="mailto:mert@clientoptimal.com">mert@clientoptimal.com</a> · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
  </footer>

  <script>
    import { mountAscii } from '../../lab/ascii.js';
    mountAscii();
  </script>

  <style is:global>
    html:has(body.sn) { background: #04143F; color-scheme: dark; }
    body.sn { --hard: #04143F; --print: #0B2C8A; --nova: #5B9BFF; --ice: #CFE0FF; --pearl: #F4F6FA; --silver: #9AA6BA;
      margin: 0; color: var(--ice); font: 400 17px/1.65 'Manrope', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
      background-color: var(--hard);
      background-image: linear-gradient(rgba(207,224,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(207,224,255,.045) 1px, transparent 1px);
      background-size: 40px 40px; }
    .sn a { color: inherit; }
    .sn :focus-visible { outline: 2px solid var(--nova); outline-offset: 3px; }
    .sn-wrap { width: min(1200px, 100% - 48px); margin-inline: auto; }
    .sn-anno { font: 500 12px/1.4 'IBM Plex Mono', monospace; letter-spacing: .16em; text-transform: uppercase; color: var(--nova); margin: 0 0 16px; }
    .sn-anno b { color: #7df0b5; font-weight: 500; }
    .sn h1, .sn h2 { font-family: 'Unbounded', sans-serif; font-weight: 700; color: #fff; margin: 0; letter-spacing: -.02em; }
    .sn h2 { font-size: clamp(34px, 4.2vw, 60px); line-height: 1.04; }
    .sn h3 { font: 700 20px/1.25 'Manrope', sans-serif; color: #fff; margin: 0 0 10px; }

    .sn-nav { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 30; width: min(1200px, 100% - 24px); display: flex; align-items: center; gap: 24px;
      padding: 8px 8px 8px 18px; border-radius: 999px; background: rgba(4,20,63,.35); border: 1px solid rgba(207,224,255,.16); backdrop-filter: blur(16px) saturate(1.5);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.08); }
    .sn-brand { font: 700 15px 'Unbounded', sans-serif; text-decoration: none; color: #fff; display: flex; gap: 8px; }
    .sn-brand span { color: var(--nova); }
    .sn-nav nav { margin-left: auto; display: flex; gap: 22px; font-size: 14.5px; }
    .sn-nav nav a { text-decoration: none; color: #b8c9ec; } .sn-nav nav a:hover { color: #fff; }

    /* glowing button with a moving edge */
    .sn-btn { position: relative; display: inline-flex; align-items: center; min-height: 54px; padding: 0 28px; border-radius: 999px; font: 700 15.5px 'Manrope', sans-serif;
      text-decoration: none; isolation: isolate; transition: transform .3s cubic-bezier(.2,.7,.2,1); }
    .sn-btn--sm { min-height: 42px; padding: 0 20px; font-size: 14px; }
    .sn-btn:hover { transform: translateY(-2px); }
    @property --sn-a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
    .sn-btn--glow { color: #fff !important; background: conic-gradient(from var(--sn-a), #5B9BFF, #ffffff, #2a5bd8, #5B9BFF); animation: sn-spin 4s linear infinite;
      box-shadow: 0 0 30px -4px rgba(91,155,255,.9), 0 0 80px -20px rgba(91,155,255,1); }
    .sn-btn--glow::before { content: ''; position: absolute; inset: 1.5px; border-radius: inherit; background: linear-gradient(180deg, #2f6cf0, #0f3fb8); z-index: -1; }
    .sn-btn--glow:hover { box-shadow: 0 0 44px -2px rgba(91,155,255,1), 0 0 120px -20px rgba(91,155,255,1); }
    @keyframes sn-spin { to { --sn-a: 360deg; } }
    .sn-btn--glass { color: #fff !important; background: rgba(255,255,255,.07); border: 1px solid rgba(207,224,255,.25); backdrop-filter: blur(12px); }
    .sn-btn--glass:hover { background: rgba(255,255,255,.14); }

    /* hero: the supernova */
    .sn-hero { position: relative; min-height: max(820px, 100svh); display: grid; place-items: center; overflow: hidden; padding: 96px 24px 64px;
      background: radial-gradient(ellipse 60% 50% at 50% 46%, #0d3aa8 0%, #061c5c 45%, var(--hard) 80%); }
    .sn-burst { position: absolute; inset: 0; margin: 0; font: 400 12px/1.15 'IBM Plex Mono', monospace; color: rgba(190,214,255,.75); white-space: pre; overflow: hidden;
      pointer-events: none; text-shadow: 0 0 10px rgba(91,155,255,.85); mix-blend-mode: screen; }
    .sn-vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 50%, transparent 35%, rgba(4,20,63,.85) 85%); }
    .sn-hero-in { position: relative; z-index: 2; text-align: center; max-width: 980px; display: flex; flex-direction: column; align-items: center; }
    .sn-h1 { font-size: clamp(40px, 4.6vw, 70px); line-height: 1; letter-spacing: -.035em; text-shadow: 0 0 40px rgba(4,20,63,.9); }
    .sn-h1 em { font-style: normal; color: var(--ice); font-weight: 500; }
    .sn-core { margin: 22px 0 0; }
    .sn-lede { max-width: 36em; font-size: 18px; color: #c6d6f5; margin: 18px 0 30px; text-shadow: 0 1px 20px rgba(4,20,63,.9); }
    .sn-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .sn-fine { font-size: 12.5px; color: var(--silver); max-width: 40em; margin: 22px 0 0; }
    .sn-rise { animation: sn-rise 1.1s cubic-bezier(.2,.7,.2,1) both; animation-delay: var(--d, 0s); }
    @keyframes sn-rise { from { opacity: 0; transform: translateY(16px) scale(.98); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }

    .sn-sec { padding: clamp(90px, 10vw, 150px) 0; position: relative; }
    .sn-head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 10px 60px; align-items: end; margin-bottom: 50px; }
    .sn-head .sn-anno { grid-column: 1 / -1; margin: 0; }
    .sn-head > p:last-child { margin: 0; color: #a9bbdf; font-size: 18px; }
    .sn-head--stack { grid-template-columns: 1fr; }
    .sn-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .sn-glass, .sn-rule, .sn-steps li { position: relative; padding: 30px; border-radius: 20px; background: linear-gradient(160deg, rgba(255,255,255,.09), rgba(255,255,255,.02));
      border: 1px solid rgba(207,224,255,.14); backdrop-filter: blur(14px); box-shadow: inset 0 1px 0 rgba(255,255,255,.1); transition: border-color .3s, transform .3s cubic-bezier(.2,.7,.2,1); }
    .sn-glass:hover, .sn-rule:hover { border-color: rgba(91,155,255,.6); transform: translateY(-3px); }
    .sn-glass p, .sn-rule p, .sn-steps p { margin: 0; color: #a9bbdf; font-size: 16px; }

    .sn-sec--how { background: linear-gradient(180deg, transparent, rgba(11,44,138,.45), transparent); }
    .sn-how { display: grid; grid-template-columns: 1.25fr 1fr; gap: 60px; align-items: center; }
    .sn-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; counter-reset: s; }
    .sn-steps li { counter-increment: s; padding: 24px 26px 24px 78px; }
    .sn-steps li::before { content: counter(s); position: absolute; left: 24px; top: 24px; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center;
      font: 500 13px 'IBM Plex Mono', monospace; color: #fff; background: var(--print); box-shadow: 0 0 18px rgba(91,155,255,.7); }
    .sn-steps span { display: inline-block; margin-top: 12px; font: 500 11px 'IBM Plex Mono', monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--nova); }
    .sn-phone { margin: 0; }
    .sn-phone-glass { padding: 26px; border-radius: 28px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.22); backdrop-filter: blur(20px);
      box-shadow: 0 30px 80px -30px rgba(91,155,255,.6), inset 0 1px 0 rgba(255,255,255,.25); animation: sn-float 6s ease-in-out infinite; }
    @keyframes sn-float { 50% { transform: translateY(-8px); } }
    .sn-msg-t { font-weight: 700; color: #fff; margin: 0 0 6px; } .sn-msg-b { margin: 0; color: #d5e2fb; }
    .sn-phone figcaption { margin-top: 14px; font-size: 13px; color: var(--silver); text-align: center; }

    .sn-rules { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }

    .sn-faqwrap { display: grid; grid-template-columns: 1fr 1.6fr; gap: 60px; align-items: start; }
    .sn-faq details { border-bottom: 1px solid rgba(207,224,255,.14); }
    .sn-faq summary { cursor: pointer; list-style: none; padding: 20px 0; font-weight: 700; font-size: 18px; color: #fff; display: flex; justify-content: space-between; gap: 20px; }
    .sn-faq summary::after { content: '+'; color: var(--nova); font-family: 'IBM Plex Mono', monospace; transition: transform .3s; }
    .sn-faq details[open] summary::after { transform: rotate(45deg); }
    .sn-faq details p { margin: 0 0 22px; color: #a9bbdf; }

    .sn-close { position: relative; overflow: hidden; min-height: 620px; display: grid; place-items: center; text-align: center; padding: 100px 24px;
      background: radial-gradient(ellipse at 50% 50%, #0d3aa8, var(--hard) 70%); }
    .sn-burst--small { font-size: 10px; opacity: .7; }
    .sn-close-in { position: relative; z-index: 1; max-width: 720px; display: flex; flex-direction: column; align-items: center; }
    .sn-close h2 { font-size: clamp(40px, 5.4vw, 78px); text-shadow: 0 0 40px rgba(4,20,63,.9); }
    .sn-close p:not(.sn-anno) { color: #c6d6f5; font-size: 18px; margin: 18px 0 30px; }
    .sn-foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 28px max(24px, calc((100% - 1200px) / 2)) 80px; color: var(--silver); font-size: 13px; border-top: 1px solid rgba(207,224,255,.1); }

    @media (max-width: 960px) {
      .sn-head, .sn-grid3, .sn-how, .sn-faqwrap { grid-template-columns: 1fr; }
      .sn-rules { grid-template-columns: 1fr 1fr; }
      .sn-nav nav { display: none; }
      .sn-burst { font-size: 9px; }
    }
    @media (max-width: 560px) { .sn-rules { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .sn *, .sn *::before { animation: none !important; transition: none !important; } }
  </style>
</Lab>
