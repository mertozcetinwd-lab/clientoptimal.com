---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Capabilities from '../components/Capabilities.astro';
import Principles from '../components/Principles.astro';
import Proof from '../components/Proof.astro';
import ContactCta from '../components/ContactCta.astro';
---

{/* Generalist homepage. Order carries the argument: position the studio (Hero),
    show the range of what gets built (Capabilities/Services), how it's built
    (Principles), the public proof, and the ask. The Reactivation component is kept
    in the repo for the future dedicated /services page, not rendered here. */}
<Base>
  <Hero />
  <Ticker />
  <Capabilities />
  <Principles />
  <Proof />
  <ContactCta />
</Base>
