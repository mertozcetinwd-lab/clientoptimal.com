---
import { principles } from '../data/site.js';
---

<section class="route-section" id="how">
  <div class="route-wrap route-principles">
    <header class="route-principles__intro">
      <h2 class="route-section__title">A call system should know its limits.</h2>
      <p class="route-annotation">Build constraints / agreed before launch</p>
      <p class="route-section__lead">The assistant follows a defined route. A person handles urgent, unclear, and out-of-scope calls. The project documents what happens when any part is unavailable.</p>
    </header>
    <ol class="route-principles__list">
      {principles.map((principle) => (
        <li class="route-principles__item">
          <span class="route-principles__index">{principle.idx}</span>
          <h3>{principle.title}</h3>
          <p>{principle.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .route-principles { display: grid; grid-template-columns: minmax(14rem, 0.78fr) minmax(0, 1.22fr); gap: clamp(2.5rem, 8vw, 9rem); align-items: start; }
  .route-principles__intro { position: sticky; top: 7rem; }
  .route-principles__intro .route-section__title { margin-bottom: 1.25rem; }
  .route-principles__intro .route-section__lead { margin-top: 1.7rem; }
  .route-principles__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair); }
  .route-principles__item { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 0.35rem 1rem; padding-block: 1.5rem; border-bottom: 1px solid var(--hair); }
  .route-principles__index { grid-row: span 2; color: var(--accent); font-family: var(--font-mono); font-size: 0.68rem; padding-top: 0.22rem; }
  .route-principles__item h3 { font-family: var(--font-display); font-size: clamp(1.25rem, 1.8vw, 1.65rem); line-height: 1.2; letter-spacing: -0.03em; }
  .route-principles__item p { max-width: 60ch; color: var(--text-dim); font-size: 0.92rem; line-height: 1.65; }
  @media (max-width: 760px) { .route-principles { grid-template-columns: 1fr; } .route-principles__intro { position: static; } }
</style>
