---
import { industries } from '../data/site.js';
---

<section class="route-section" id="fit">
  <div class="route-wrap">
    <header class="route-section__head">
      <div>
        <h2 class="route-section__title">{industries.title}</h2>
        <p class="route-annotation route-patterns__annotation">Fit / call patterns</p>
      </div>
      <p class="route-section__lead">{industries.lead}</p>
    </header>

    <ol class="route-patterns">
      {industries.patterns.map((pattern, index) => (
        <li class="route-patterns__item">
          <span class="route-patterns__index">0{index + 1}</span>
          <h3>{pattern.name}</h3>
          <p>{pattern.desc}</p>
          <span class="route-patterns__mark" aria-hidden="true">↗</span>
        </li>
      ))}
    </ol>
    <p class="route-patterns__note">{industries.note}</p>
  </div>
</section>

<style>
  .route-patterns__annotation { margin-top: 1.2rem; }
  .route-patterns { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair); }
  .route-patterns__item {
    display: grid;
    grid-template-columns: 4rem minmax(12rem, 0.72fr) minmax(0, 1.28fr) 2rem;
    align-items: start;
    gap: 1rem;
    padding-block: 1.65rem;
    border-bottom: 1px solid var(--hair);
  }
  .route-patterns__index { padding-top: 0.35rem; color: var(--accent); font-family: var(--font-mono); font-size: 0.68rem; }
  .route-patterns__item h3 { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.8rem); line-height: 1.15; letter-spacing: -0.03em; }
  .route-patterns__item p { max-width: 58ch; color: var(--text-dim); line-height: 1.65; }
  .route-patterns__mark { justify-self: end; color: var(--accent); font-size: 1.2rem; }
  .route-patterns__note { max-width: 70ch; margin-top: 1.25rem; color: var(--muted); font-size: 0.8rem; line-height: 1.6; }
  @media (max-width: 680px) {
    .route-patterns__item { grid-template-columns: 2.3rem minmax(0, 1fr) 1.4rem; gap: 0.5rem 0.8rem; }
    .route-patterns__item h3 { grid-column: 2; }
    .route-patterns__item p { grid-column: 2; }
    .route-patterns__mark { grid-column: 3; grid-row: 1; }
  }
</style>
