---
// General call-pattern fit criteria. The offer is industry-neutral, and each
// business still needs an appropriate call flow and human follow-up route.
import { industries } from '../data/site.js';
---

<section class="section" id="industries">
  <div class="wrap">
    <p class="eyebrow badge"><span class="badge-dot" aria-hidden="true"></span>{industries.eyebrow}</p>
    <h2 class="section-title reveal">{industries.title}</h2>
    <p class="lead intro reveal">{industries.lead}</p>

    <ul class="grid">
      {industries.patterns.map((t, i) => (
        <li class="cell reveal" style={`--i:${i % 3}`}>
          <span class="name">{t.name}</span>
          <span class="desc">{t.desc}</span>
        </li>
      ))}
    </ul>

    <p class="note reveal">{industries.note}</p>
  </div>
</section>

<style>
  .section-title { margin-block: 1.2rem 1.4rem; max-width: 24ch; }
  .intro { margin-bottom: 3.8rem; }

  .grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--hair-w) solid var(--hair);
    border-inline-start: var(--hair-w) solid var(--hair);
  }

  .cell {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: clamp(1.4rem, 3vw, 2.1rem);
    border-bottom: var(--hair-w) solid var(--hair);
    border-inline-end: var(--hair-w) solid var(--hair);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 700; letter-spacing: -0.02em;
  }

  .desc {
    font-size: var(--step-small);
    color: var(--text-dim);
    line-height: 1.6;
  }

  .note {
    margin-top: 1.8rem;
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
