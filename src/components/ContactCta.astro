---
import { cta, contact } from '../data/site.js';
---

<section class="route-cta" id="contact">
  <div class="route-wrap">
    <div class="route-cta__grid">
      <div>
        <h2>{cta.title}</h2>
        <p>{cta.lead}</p>
        <div class="route-cta__actions">
          <button type="button" class="route-button" data-open-voice-widget>Hear the sample <span aria-hidden="true">↗</span></button>
          <a class="route-button route-button--quiet" href="/contact">Discuss a call flow <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="route-cta__direct">
        <span class="route-annotation">Direct contact</span>
        <a href={`mailto:${contact.email}`}>{contact.email}<span aria-hidden="true">↗</span></a>
        <a href={contact.linkedin} target="_blank" rel="noopener">{contact.linkedinShow}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .route-cta { padding-block: clamp(4.5rem, 10vw, 9rem); background: var(--accent-fill); color: var(--accent-fill-ink); }
  .route-cta__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr); gap: clamp(2.5rem, 8vw, 8rem); align-items: end; }
  .route-cta h2 { max-width: 12ch; font-family: var(--font-display); font-size: clamp(3rem, 7.6vw, 7.4rem); font-weight: 700; line-height: 0.91; letter-spacing: -0.07em; text-wrap: balance; }
  .route-cta__grid > div:first-child > p { max-width: 58ch; margin-top: 1.35rem; color: color-mix(in srgb, var(--accent-fill-ink) 88%, transparent); line-height: 1.65; }
  .route-cta .route-button { border-color: var(--accent-fill-ink); background: var(--accent-fill-ink); color: var(--accent-fill); }
  .route-cta .route-button--quiet { background: transparent; color: var(--accent-fill-ink); }
  .route-cta__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .route-cta__direct { display: grid; justify-items: start; gap: 0.85rem; }
  .route-cta__direct .route-annotation { color: inherit; opacity: 0.75; }
  .route-cta__direct a { display: flex; min-height: 44px; align-items: center; gap: 0.55rem; color: inherit; text-decoration-color: color-mix(in srgb, var(--accent-fill-ink) 55%, transparent); }
  @media (max-width: 760px) { .route-cta__grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .route-cta__actions { flex-direction: column; align-items: stretch; } }
</style>
