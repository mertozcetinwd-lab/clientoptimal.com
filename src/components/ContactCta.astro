---
import { cta, contact } from '../data/site.js';
---

<section class="section cta" id="contact">
  <div class="wrap">
    <p class="eyebrow badge"><span class="badge-dot" aria-hidden="true"></span>{cta.eyebrow}</p>
    <h2 class="section-title big reveal">{cta.title}</h2>
    <p class="lead intro reveal">{cta.lead}</p>

    <div class="ways">
      <a class="way" href={contact.linkedin} target="_blank" rel="noopener">
        <span class="label">LinkedIn</span>
        <span class="val">{contact.linkedinShow}</span>
      </a>
      <a class="way" href={`mailto:${contact.email}`}>
        <span class="label">Email</span>
        <span class="val">{contact.email}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta { border-top: var(--hair-w) solid var(--hair); }

  .section-title { margin-block: 1.2rem 1.4rem; }
  .big { max-width: 26ch; }
  .intro { margin-bottom: 3.4rem; }

  .ways { display: flex; flex-wrap: wrap; gap: 1.2rem 4rem; }

  .way {
    display: flex; flex-direction: column; gap: 0.35rem;
    text-decoration: none;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted);
  }

  .val {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 700; letter-spacing: -0.02em;
    /* Underline draws on hover. Lives on the child, never on the .reveal
       element, because the reveal animation's `both` fill would outrank it. */
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    transition: background-size var(--t-med) var(--ease);
    padding-bottom: 2px;
  }
  .way:hover .val, .way:focus-visible .val { background-size: 100% 2px; }

  @media (max-width: 520px) {
    .ways { gap: 1.6rem; }
    .val { font-size: 1.15rem; word-break: break-all; }
  }
</style>
