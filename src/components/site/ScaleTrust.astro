---
// "Small business to enterprise" (Mert, 2026-11-09). The compliance line is the VOICE PLATFORM's
// claim (Retell AI's own marketing: SOC 2 Type II, HIPAA, GDPR, ISO 27001), labelled as such.
// Client Optimal itself holds no certification, so it never says "we are compliant".
const cards = [
  { t: 'Scales with you', d: 'The same setup runs for one location or many, from a handful of calls a week to thousands. Nothing to rebuild as you grow.' },
  { t: 'Enterprise-grade platform', d: 'Runs on a production voice AI platform whose provider reports SOC 2 Type II, HIPAA, GDPR and ISO 27001 compliance.' },
  { t: 'Sensitive details redacted', d: 'Card numbers, IDs and other private details can be redacted from calls and transcripts, set to your rules.' },
  { t: 'We run it for you', d: 'Setup, testing, monitoring and changes are handled for you. You get the texts and the booked customers, not another tool to manage.' },
];
---
<section class="d-section scale" data-reveal>
  <div class="d-wrap">
    <div class="d-head">
      <div>
        <p class="d-eyebrow">Small business to enterprise</p>
        <h2 class="d-display">Built to scale.<br /><span class="d-grad">Run for you.</span></h2>
      </div>
      <p>Whether you take ten calls a day or ten thousand, the voice AI is built on infrastructure made for production, and we operate it on your behalf.</p>
    </div>
    <div class="scale-grid">
      {cards.map((c, i) => (
        <article class="scale-card">
          <span class="scale-n" aria-hidden="true">{['↗', '✓', '◐', '⚙'][i]}</span>
          <h3>{c.t}</h3>
          <p>{c.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .scale-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .scale-card { padding: 26px; border-radius: var(--r-panel); border: 1px solid var(--line); background: linear-gradient(160deg, #fff, var(--ice, #eef4ff)); transition: transform .3s var(--ease), box-shadow .3s; }
  .scale-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -24px rgba(21, 70, 179, .45); }
  .scale-n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--navy); color: var(--sky); font-size: 18px; }
  .scale-card h3 { margin: 18px 0 8px; font: 800 22px/1.1 var(--display); font-stretch: 80%; color: var(--ink); }
  .scale-card p { margin: 0; color: var(--muted); font-size: 15.5px; line-height: 1.55; }
  @media (max-width: 1000px) { .scale-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .scale-grid { grid-template-columns: 1fr; } }
</style>
