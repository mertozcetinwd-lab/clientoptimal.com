---
// The about page's one content section. Short by design: this page exists to put
// a person behind the business, not to restate the services.
import { about, aboutMeta } from '../data/site.js';
---

<section class="about">
  <div class="wrap grid">
    <div class="text">
      <p class="eyebrow badge"><span class="badge-dot" aria-hidden="true"></span>{about.eyebrow}</p>
      <h1 class="display title reveal">{about.title}</h1>
      <p class="lead intro reveal">{about.lead}</p>

      <div class="prose">
        {about.paras.map((p, i) => (
          <p class="para reveal" style={`--i:${i}`}>{p}</p>
        ))}
      </div>
    </div>

    <div class="portrait reveal">
      <img
        src="/img/mert/mert-ozcetin-400.jpg"
        srcset="/img/mert/mert-ozcetin-400.webp 1x, /img/mert/mert-ozcetin-800.webp 2x"
        width="400"
        height="400"
        alt="Mert Ozcetin, founder of Client Optimal"
        loading="lazy"
        decoding="async"
      />
      <p class="caption">{aboutMeta.founder}, founder</p>
    </div>
  </div>
</section>

<style>
  /* No top border: first thing under the header, so a hairline there would read
     as a stray rule rather than a divider. */
  .about { padding-block: clamp(3.2rem, 9vh, 6rem) var(--section-y); }

  .grid {
    display: grid;
    grid-template-columns: 1fr 0.42fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .title {
    font-size: var(--step-h2);
    max-width: 18ch;
    margin-block: 1.4rem 1.5rem;
  }

  .intro { margin-bottom: 3.2rem; }

  /* Reading column, not the full wrap. Body prose past --measure is
     genuinely harder to read and this page is nothing but prose. */
  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.7rem;
    max-width: var(--measure);
  }
  .para { color: var(--text-dim); }

  .portrait { padding-top: 0.6rem; max-width: 260px; }
  .portrait img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; }
  .caption {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    .portrait { max-width: 240px; order: -1; margin-bottom: 1.2rem; }
  }
</style>
