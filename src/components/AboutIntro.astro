---
import { about } from '../data/site.js';
---

<section class="route-about">
  <div class="route-wrap route-about__layout">
    <div class="route-about__copy">
      <h1 class="route-about__title">{about.title}</h1>
      <p class="route-about__lead">{about.lead}</p>
      <div class="route-about__prose">
        {about.paras.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <figure class="route-about__portrait">
      <img
        src="/img/mert/mert-ozcetin-400.jpg"
        srcset="/img/mert/mert-ozcetin-400.webp 1x, /img/mert/mert-ozcetin-800.webp 2x"
        width="400"
        height="400"
        alt="Mert Ozcetin, founder of Client Optimal"
        loading="lazy"
        decoding="async"
      />
      <figcaption><span class="route-annotation">Client Optimal / founder</span></figcaption>
    </figure>
  </div>
</section>

<style>
  .route-about { padding-block: clamp(3.5rem, 8vw, 7.5rem); }
  .route-about__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.45fr); gap: clamp(2.5rem, 9vw, 9rem); align-items: start; }
  .route-about__title { max-width: 9ch; font-family: var(--font-display); font-size: clamp(4rem, 10vw, 9rem); font-weight: 700; line-height: 0.87; letter-spacing: -0.075em; }
  .route-about__lead { max-width: 55ch; margin-block: 1.7rem 2.2rem; color: var(--text); font-size: clamp(1.15rem, 1.7vw, 1.5rem); line-height: 1.5; }
  .route-about__prose { display: grid; gap: 1.2rem; max-width: 64ch; }
  .route-about__prose p { color: var(--text-dim); line-height: 1.72; }
  .route-about__portrait { position: sticky; top: 7.5rem; margin: 0; padding-top: 4rem; }
  .route-about__portrait img { width: 100%; aspect-ratio: 0.82; object-fit: cover; object-position: 50% 35%; filter: saturate(0.72); }
  .route-about__portrait figcaption { padding-top: 0.8rem; }
  @media (max-width: 760px) { .route-about__layout { grid-template-columns: 1fr; } .route-about__portrait { position: static; order: -1; max-width: 19rem; padding-top: 0; } }
</style>
