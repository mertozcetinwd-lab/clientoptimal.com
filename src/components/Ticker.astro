---
// A static, accessible summary of the proposed call-flow requirements.
const items = [
  'AI disclosure first',
  'Approved intake questions',
  'Human fallback',
  'No assumed booking',
  'Phone route to confirm',
  'Written handover',
];
---

<ul class="ticker" aria-label="Call flow requirements">
  {items.map((t) => <li class="item"><span class="sep" aria-hidden="true">/</span>{t}</li>)}
</ul>

<style>
  .ticker {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem 0;
    list-style: none;
    margin: 0;
    padding: 0.35rem 0.5rem;
    border-block: var(--hair-w) solid var(--hair);
    background: var(--bg-2);
    /* Sits above the fixed grain overlay (z-index 1) so the band reads as solid. */
    position: relative;
    z-index: 2;
  }
  .item {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sep { color: var(--accent); }

</style>
