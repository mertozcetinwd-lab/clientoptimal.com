---
import { fit } from '../data/site.js';
---

<section class="route-section route-section--field" id="fit-check">
  <div class="route-wrap">
    <header class="route-section__head">
      <div>
        <h2 class="route-section__title">{fit.title}</h2>
        <p class="route-annotation route-fit__annotation">Fit / decide from the real call path</p>
      </div>
      <p class="route-section__lead">{fit.lead}</p>
    </header>
    <div class="route-fit">
      <section class="route-fit__side route-fit__side--yes">
        <h3>{fit.good.title}</h3>
        <ul>{fit.good.items.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="route-fit__side">
        <h3>{fit.bad.title}</h3>
        <ul>{fit.bad.items.map((item) => <li>{item}</li>)}</ul>
      </section>
    </div>
  </div>
</section>

<style>
  .route-fit__annotation { margin-top: 1.2rem; }
  .route-fit { display: grid; grid-template-columns: 1fr 1fr; }
  .route-fit__side { padding: clamp(1.2rem, 3vw, 2.5rem); border-top: 1px solid var(--hair-2); }
  .route-fit__side:first-child { padding-left: 0; }
  .route-fit__side + .route-fit__side { border-left: 1px solid var(--hair); }
  .route-fit__side h3 { margin-bottom: 1.2rem; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.4rem); letter-spacing: -0.04em; }
  .route-fit__side--yes h3 { color: var(--accent); }
  .route-fit__side ul { list-style: none; margin: 0; padding: 0; }
  .route-fit__side li { position: relative; padding: 0.8rem 0 0.8rem 1.3rem; border-top: 1px solid var(--hair); color: var(--text-dim); font-size: 0.88rem; line-height: 1.6; }
  .route-fit__side li::before { position: absolute; top: 1.4rem; left: 0; width: 6px; height: 6px; border: 1px solid var(--accent); content: ''; transform: rotate(45deg); }
  @media (max-width: 680px) { .route-fit { grid-template-columns: 1fr; } .route-fit__side:first-child { padding-left: 0; padding-right: 0; } .route-fit__side + .route-fit__side { padding-inline: 0; border-left: 0; } }
</style>
