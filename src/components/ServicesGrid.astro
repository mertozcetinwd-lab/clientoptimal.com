---
// The six services in full. Same source as the homepage grid (site.js
// `capabilities`), so titles and one-liners can never drift between the two
// pages; this one additionally renders the `includes` detail.
//
// Card shape follows the house rig.ai idiom from Capabilities.astro: a 2px accent
// rule across the top, number + tag on one line, then title, copy, and here a
// hairline-separated list of what actually gets built.
import { capabilities } from '../data/site.js';
---

<section class="section" id="services">
  <div class="wrap">
    <p class="eyebrow badge"><span class="badge-dot" aria-hidden="true"></span>Services</p>
    <h2 class="section-title reveal">Six kinds of build.</h2>
    <p class="lead intro reveal">
      Most projects are some mix of these rather than one clean category. Every
      bullet below is a thing that gets built, not a result you should expect.
    </p>

    <ul class="grid">
      {capabilities.map((c, i) => (
        <li class="cell reveal" style={`--i:${i % 3}`}>
          <div class="chead">
            <span class="num">{c.idx}</span>
            <span class="tag">{c.tag}</span>
          </div>
          <h3 class="name">{c.title}</h3>
          <p class="desc">{c.desc}</p>
          <ul class="includes">
            {c.includes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-title { margin-block: 1.2rem 1.4rem; max-width: 24ch; }
  .intro { margin-bottom: 3.8rem; }

  .grid {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .cell {
    display: flex; flex-direction: column;
    border-top: 2px solid var(--accent);
    padding-top: 1.6rem;
  }

  .chead {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.3rem;
  }
  .num {
    font-family: var(--font-display);
    font-weight: 700; font-size: 2.1rem; line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 700; line-height: 1.15; letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }

  .desc {
    font-size: var(--step-small);
    color: var(--text-dim);
    line-height: 1.6;
    margin-bottom: 1.3rem;
  }

  /* What gets built. Hairline rows rather than bullet glyphs, matching the
     divider idiom used by Principles/Faq/Proof. `margin-top: auto` pins the list
     to the bottom so cards of uneven copy length still line their lists up. */
  .includes {
    list-style: none; padding: 0; margin-top: auto;
    border-top: var(--hair-w) solid var(--hair);
  }
  .includes li {
    padding-block: 0.85rem;
    border-bottom: var(--hair-w) solid var(--hair);
    font-family: var(--font-mono);
    /* These are content, not labels. Mono keeps the spec-sheet register, but the
       first pass ran them at 0.68rem/--muted, which is below the eyebrow step and
       reads as fine print. --text-dim at 0.72rem stays technical and legible. */
    font-size: 0.72rem;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: var(--text-dim);
  }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
