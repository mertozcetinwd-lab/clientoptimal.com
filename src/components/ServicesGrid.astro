---
import { capabilities } from '../data/site.js';
---

<section class="route-section" id="services">
  <div class="route-wrap">
    <header class="route-section__head">
      <h2 class="route-section__title">One connected implementation.</h2>
      <p class="route-section__lead">A project is scoped to your phone system and agreed call flow. The exact provider, integrations, and support terms are confirmed before any live routing changes.</p>
    </header>
    <ol class="route-capabilities">
      {capabilities.map((capability) => (
        <li class="route-capabilities__item">
          <div class="route-capabilities__number">{capability.idx}<span>{capability.tag}</span></div>
          <div class="route-capabilities__main">
            <h3>{capability.title}</h3>
            <p>{capability.desc}</p>
          </div>
          <ul>
            {capability.includes.map((item) => <li>{item}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .route-capabilities { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair); }
  .route-capabilities__item { display: grid; grid-template-columns: 9rem minmax(14rem, 0.85fr) minmax(15rem, 1.15fr); gap: clamp(1rem, 3vw, 3rem); padding-block: 2rem; border-bottom: 1px solid var(--hair); }
  .route-capabilities__number { display: flex; flex-direction: column; gap: 0.55rem; color: var(--accent); font-family: var(--font-display); font-size: 2.25rem; font-weight: 650; line-height: 1; }
  .route-capabilities__number span { color: var(--muted); font-family: var(--font-mono); font-size: 0.62rem; font-weight: 400; letter-spacing: 0.09em; text-transform: uppercase; }
  .route-capabilities__main h3 { margin-bottom: 0.55rem; font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 2rem); line-height: 1.1; letter-spacing: -0.035em; }
  .route-capabilities__main p { color: var(--text-dim); font-size: 0.91rem; line-height: 1.65; }
  .route-capabilities__item > ul { list-style: none; padding: 0; border-top: 1px solid var(--hair); }
  .route-capabilities__item > ul li { padding-block: 0.65rem; border-bottom: 1px solid var(--hair); color: var(--text-dim); font-size: 0.8rem; line-height: 1.5; }
  @media (max-width: 800px) { .route-capabilities__item { grid-template-columns: 5rem minmax(0, 1fr); } .route-capabilities__item > ul { grid-column: 2; } }
  @media (max-width: 520px) { .route-capabilities__item { grid-template-columns: 3rem minmax(0, 1fr); gap: 0.8rem; } .route-capabilities__number { font-size: 1.8rem; } .route-capabilities__number span { font-size: 0.55rem; overflow-wrap: anywhere; } }
</style>
