---
import { engagement } from '../data/site.js';
---

<section class="route-section route-section--field" id="approach">
  <div class="route-wrap">
    <header class="route-section__head">
      <div>
        <h2 class="route-section__title">{engagement.title}</h2>
        <p class="route-annotation route-engagement__annotation">Implementation / then support</p>
      </div>
      <p class="route-section__lead">{engagement.lead}</p>
    </header>

    <ol class="route-steps">
      {engagement.steps.map((step) => (
        <li class="route-steps__item">
          <span class="route-steps__node" aria-hidden="true"></span>
          <div>
            <span class="route-steps__meta">Step {step.idx}</span>
            <h3 class="route-steps__title">{step.title}</h3>
            <p class="route-steps__copy">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .route-engagement__annotation { margin-top: 1.2rem; }
  .route-steps { max-width: 960px; }
</style>
