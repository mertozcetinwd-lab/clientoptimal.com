---
import { elsewhere, contact } from '../data/site.js';
---

<section class="route-section route-section--field" id="elsewhere">
  <div class="route-wrap route-elsewhere">
    <h2 class="route-section__title">{elsewhere.title}</h2>
    <div>
      <p class="route-section__lead">{elsewhere.lead}</p>
      <a class="route-elsewhere__link" href={contact.personalSite} target="_blank" rel="noopener">
        <span class="route-annotation">Personal site</span>
        <span>{contact.personalSiteShow}<b aria-hidden="true">↗</b></span>
      </a>
    </div>
  </div>
</section>

<style>
  .route-elsewhere { display: grid; grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 8vw, 8rem); align-items: start; }
  .route-elsewhere__link { display: inline-grid; gap: 0.45rem; margin-top: 1.7rem; color: var(--text); text-decoration: none; }
  .route-elsewhere__link > span:last-child { display: flex; align-items: center; gap: 0.8rem; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.3rem); font-weight: 650; letter-spacing: -0.04em; }
  .route-elsewhere__link b { color: var(--accent); font-size: 1rem; }
  .route-elsewhere__link:hover > span:last-child { color: var(--accent); }
  @media (max-width: 700px) { .route-elsewhere { grid-template-columns: 1fr; } }
</style>
