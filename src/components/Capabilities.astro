---
import { capabilities } from '../data/site.js';
---

<section class="section" id="build">
  <div class="wrap">
    {/* The homepage services overview. Generalist: these six are the kinds of
        build Client Optimal takes on, each shipped at least once (that is why none
        needed inventing). Reactivation is one offer among these, detailed in full
        on the future /services page. The abstract "plate" figurines were dropped;
        the cards are rig.ai-style bordered blocks now. */}
    <p class="eyebrow badge"><span class="badge-dot" aria-hidden="true"></span>Services</p>
    <h2 class="section-title reveal">What I actually build.</h2>
    <p class="lead intro reveal">
      Not a menu of buzzwords. Six kinds of build I have actually shipped, from a
      one-off script to the infrastructure a whole system runs on. Most projects are
      some mix of these.
    </p>

    <ul class="grid">
      {capabilities.map((c, i) => (
        <li class="cell reveal" style={`--i:${i % 3}`}>
          <div class="chead">
            <span class="num">{c.idx}</span>
            <span class="tag">{c.tag}</span>
          </div>
          <h3 class="name">{c.title}</h3>
          <p class="desc">{c.desc}</p>
        </li>
      ))}
    </ul>

    {/* This affordance was held back until the route actually existed. */}
    <p class="more reveal">
      <a class="link" href="/services">What each one includes, and how a project runs &rarr;</a>
    </p>
  </div>
</section>

<style>
  .section-title { margin-block: 1.2rem 1.4rem; max-width: 24ch; }
  .intro { margin-bottom: 3.4rem; }

  .grid {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.6rem, 3vw, 2.4rem);
  }

  /* rig.ai card: an accent rule across the top, number + tag on one line, then
     the title and copy. No decorative figure. */
  .cell {
    display: flex; flex-direction: column;
    border-top: 2px solid var(--accent);
    padding-top: 1.3rem;
  }

  .chead {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.1rem;
  }
  .num {
    font-family: var(--font-display);
    font-weight: 700; font-size: 1.9rem; line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 700; line-height: 1.15; letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }

  .desc { font-size: var(--step-small); color: var(--text-dim); line-height: 1.6; }

  .more {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
