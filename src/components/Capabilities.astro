---
import Plate from './Plate.astro';
import { capabilities } from '../data/site.js';
---

<section class="section" id="build">
  <div class="wrap">
    {/* Re-headed so it reads as the wider practice, not a second offer competing
        with reactivation for the visitor's attention. Reactivation is the front
        door; this is what else is behind it. */}
    <p class="eyebrow">The wider practice</p>
    <h2 class="section-title reveal">Reactivation is the front door. This is the rest of the house.</h2>
    <p class="lead intro reveal">
      A win-back campaign is one automation among many. The same hands build the
      rest of it: the scheduled jobs, the agents, and the plumbing that keeps them
      running after launch.
    </p>

    <ul class="grid">
      {capabilities.map((c, i) => (
        <li class="cell reveal">
          <div class="plate-wrap" aria-hidden="true">
            <Plate kind={c.plate} seed={i * 13 + 3} ratio="16 / 9" />
          </div>
          <p class="idx">{c.idx} / {c.tag}</p>
          <h3 class="name">{c.title}</h3>
          <p class="desc">{c.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-title { margin-block: 1.2rem 1.4rem; max-width: 24ch; }
  .intro { margin-bottom: 3rem; }

  .grid {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.8rem, 3.5vw, 3rem);
  }

  .cell { display: flex; flex-direction: column; }

  .plate-wrap {
    border: var(--hair-w) solid var(--hair);
    margin-bottom: 1.2rem;
    opacity: 0.75;
    transition: opacity var(--t-med) var(--ease), border-color var(--t-med) var(--ease);
  }
  .cell:hover .plate-wrap { opacity: 1; border-color: var(--hair-2); }

  .idx {
    font-family: var(--font-mono);
    font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    font-weight: 700; line-height: 1.15; letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }

  .desc { font-size: var(--step-small); color: var(--text-dim); line-height: 1.6; }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
