---
import { meta, contact, legalNav } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="route-footer">
  <div class="route-wrap">
    <ol class="route-footer__path" aria-label="A considered call route">
      <li class="route-footer__stop">Identify as AI</li>
      <li class="route-footer__stop">Follow approved intake</li>
      <li class="route-footer__stop">Escalate to a person</li>
      <li class="route-footer__stop">Support by agreement</li>
    </ol>
    <div class="route-footer__main">
      <div class="route-footer__brand">
        <a href="/" aria-label={`${meta.name} home`}>
          <svg viewBox="0 0 34 34" aria-hidden="true" width="34">
            <path d="M3 17h8l4-8 5 16 4-8h7" fill="none" stroke="currentColor" stroke-width="1.7" />
          </svg>
          <span>{meta.name}</span>
        </a>
        <p>Custom AI voice-agent implementation and ongoing support for suitable inbound call workflows.</p>
      </div>

      <nav class="route-footer__column" aria-label="Explore">
        <h2>Explore</h2>
        <ul class="route-footer__links">
          <li><a href="/services">Implementation &amp; support</a></li>
          <li><a href="/demo">Hear the sample</a></li>
          <li><a href="/about">About Mert</a></li>
        </ul>
      </nav>

      <div class="route-footer__column">
        <h2>Contact &amp; details</h2>
        <ul class="route-footer__links">
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={`tel:${contact.phone}`}>{contact.phoneShow}</a></li>
          {legalNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
        <p class="route-footer__address">{meta.legalName}<br />{contact.addressRegistered}</p>
      </div>
    </div>
    <div class="route-footer__bottom">
      <span>© {year} {meta.legalName}</span>
      <nav aria-label="Elsewhere">
        <a href={contact.personalSite} target="_blank" rel="noopener">{contact.personalSiteShow}</a>
        <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={contact.github} target="_blank" rel="noopener">GitHub</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .route-footer__bottom nav { display: flex; flex-wrap: wrap; gap: 1.1rem; }
  .route-footer__bottom nav a { color: var(--muted); text-decoration-color: var(--hair-2); }
  .route-footer__bottom nav a:hover { color: var(--accent); }
</style>
