---
import { faq } from '../data/site.js';
---

<section class="route-section" id="faq">
  <div class="route-wrap">
    <header class="route-section__head">
      <h2 class="route-section__title">{faq.title}</h2>
      <p class="route-section__lead">The details that should be clear before a phone route changes.</p>
    </header>
    <div class="route-faq">
      {faq.items.map((item) => (
        <details class="route-faq__row" name="faq">
          <summary>
            <span class="route-faq__question">{item.q}</span>
            <span class="route-faq__toggle" aria-hidden="true"></span>
          </summary>
          <p class="route-faq__answer">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
