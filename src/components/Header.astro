---
// Sticky, not fixed, and no bottom bar. mertozcetin.com's twin chrome rails
// are Mert's signature; a business site wants the browser to feel normal.
import { meta, nav, contact } from '../data/site.js';

// The homepage opens on a full-screen near-black 3D hero, so the header renders
// dark ("over-hero") to blend into it, then a scroll script swaps it back to the
// themed solid once you pass the hero. Server-rendered initial state = no flash.
const isHome = Astro.url.pathname === '/';
---

<header class:list={['hdr', isHome && 'over-hero']} data-home={isHome ? '' : null}>
  <div class="wrap inner">
    {/* The favicon mark, inlined and stripped of its tile.
        public/favicon.svg draws the same C and dot on a solid obsidian square,
        which a tab icon needs to stay visible but a header does not: on the light
        theme it would paste a black chip onto the alabaster bar. So the rect is
        dropped and the stroke is currentColor, which means the mark inherits
        .brand's colour and follows the theme (and the white over-hero override)
        for free. Only the dot is pinned, to --accent-fill, so the brand blue
        stays one constant colour rather than shifting with the theme.

        If favicon.svg is ever redrawn, redraw this path with it. */}
    <a class="brand" href="/">
      <svg class="mark" viewBox="8 8 48 48" aria-hidden="true" focusable="false">
        <path d="M44 20.5a17 17 0 1 0 0 23" fill="none" stroke="currentColor"
              stroke-width="7" stroke-linecap="square" />
        <circle cx="47" cy="32" r="5" fill="var(--accent-fill)" />
      </svg>
      {/* The link is now image-only, so the accessible name has to come from
          somewhere. Real text beats aria-label for AT and crawlers alike. */}
      <span class="sr-only">{meta.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <div class="right">
      <div class="themes" role="group" aria-label="Colour mode">
        <button type="button" data-theme-set="dark" title="Dark mode">Dark</button>
        <button type="button" data-theme-set="light" title="Light mode">Light</button>
      </div>
      <a class="talk" href={contact.linkedin} target="_blank" rel="noopener">Get in touch</a>
    </div>
  </div>
</header>

<script>
  // Homepage only: the header renders .over-hero (dark, server-rendered) and
  // drops it once the viewport scrolls past the near-black hero, returning to the
  // themed solid. Passive scroll listener, cheap.
  (function () {
    const hdr = document.querySelector('.hdr');
    if (!hdr || hdr.dataset.home !== '') return;
    const sync = () => {
      const overHero = window.scrollY < window.innerHeight - hdr.offsetHeight - 4;
      hdr.classList.toggle('over-hero', overHero);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
  })();
</script>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--hair-w) solid var(--hair);
    transition: background-color var(--t-med) var(--ease), border-color var(--t-med) var(--ease);
  }

  /* Over the near-black hero: a solid dark bar that blends into it, white type.
     The scroll script removes .over-hero once you scroll past the hero, and the
     header returns to the themed solid above. Colours transition for both. */
  .hdr.over-hero {
    background: #020306;
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }
  .hdr.over-hero .brand { color: #fff; }
  .hdr.over-hero .nav a { color: rgba(255, 255, 255, 0.6); }
  .hdr.over-hero .nav a:hover { color: #fff; }
  .hdr.over-hero .themes { border-color: rgba(255, 255, 255, 0.22); }
  .hdr.over-hero .themes button { color: rgba(255, 255, 255, 0.6); }
  .hdr.over-hero .themes button:hover { color: #fff; }
  .hdr.over-hero .themes button[aria-pressed='true'] { background: #fff; color: #020306; }
  /* .talk gets NO over-hero override: it is a filled azure button now, and it
     reads correctly on both the near-black hero and the themed bar. Tinting its
     border white here would only outline the fill. */
  .brand, .nav a, .themes button { transition: color var(--t-med) var(--ease), border-color var(--t-med) var(--ease); }
  .inner {
    height: var(--header-h);
    display: flex; align-items: center; gap: 1.5rem;
  }

  .brand {
    display: inline-flex; align-items: center;
    text-decoration: none;
    /* currentColor feeds the mark's stroke; the over-hero rule swaps this to
       #fff and the mark follows without a second override. */
    color: var(--text);
  }
  .mark {
    width: 48px; height: 48px;
    flex: none;
    display: block;
  }

  .nav {
    display: flex; gap: 1.6rem;
    margin-inline-start: auto;
  }
  .nav a {
    font-family: var(--font-mono);
    font-size: 1rem; letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }
  .nav a:hover { color: var(--text); }

  .right { display: flex; align-items: center; gap: 1rem; }

  .themes { display: flex; border: var(--hair-w) solid var(--hair); }
  .themes button {
    background: none; border: 0; cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--muted);
    padding: 0.6em 0.95em;
    transition: color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease);
  }
  .themes button:hover { color: var(--text); }
  .themes button[aria-pressed='true'] { background: var(--text); color: var(--bg); }

  /* Filled azure, matching .btn.primary: same --accent-fill ground and white ink
     (5.27:1, AA in both themes), and the same TL/BR chamfer, because every other
     filled control on the site carries it and an unchamfered one would read as an
     oversight. --accent-fill deliberately, not --accent: the bright azure is the
     GROUND token and stays constant across themes; --accent is the darker
     text/rules token and would muddy a fill. */
  .talk {
    font-family: var(--font-mono);
    font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    padding: 0.85em 1.4em;
    background: var(--accent-fill);
    color: var(--accent-fill-ink);
    border: var(--hair-w) solid var(--accent-fill);
    white-space: nowrap;
    clip-path: polygon(
      var(--chamfer) 0, 100% 0,
      100% calc(100% - var(--chamfer)),
      calc(100% - var(--chamfer)) 100%,
      0 100%, 0 var(--chamfer));
    transition: filter var(--t-fast) var(--ease);
  }
  .talk:hover { filter: brightness(1.08); }

  /* Sacrifice order, most expendable first: the duplicate CTA goes, then the
     theme toggle. NAV LINKS ARE NEVER HIDDEN. Dropping them below a breakpoint
     once left phones with no way around the sibling site, and "it still has the
     brand link" is not navigation. Below 560px the header becomes two rows
     instead, which costs 2rem of height and keeps everything reachable. */
  @media (max-width: 900px) { .talk { display: none; } }

  @media (max-width: 560px) {
    .inner {
      height: auto;
      flex-wrap: wrap;
      row-gap: 0.15rem;
      padding-block: 0.7rem;
    }
    .mark { width: 36px; height: 36px; }
    .right { margin-inline-start: auto; }
    .nav {
      order: 3;
      width: 100%;
      margin-inline-start: 0;
      gap: 1.15rem;
      /* If three labels ever outgrow a narrow phone, they scroll sideways
         rather than disappearing or wrapping into a ragged stack. */
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav::-webkit-scrollbar { display: none; }
    .nav a { font-size: 0.68rem; white-space: nowrap; }
  }

  @media (max-width: 380px) {
    .themes { display: none; }
  }

  /* Touch devices get 44px-minimum tap targets (WCAG 2.5.5 / platform guidance)
     without touching the compact mouse layout — scoped to coarse pointers only,
     so nothing changes on desktop. Also gives an :active colour flip, since a
     finger has no hover to signal the press. */
  @media (pointer: coarse) {
    .nav a { min-height: 44px; display: inline-flex; align-items: center; }
    .themes button { min-height: 44px; }
    /* The brand is an icon-only link now, so its hit area is the 24px mark
       unless it is padded out to the same minimum as everything else. */
    .brand { min-height: 44px; min-width: 44px; }
    .talk { min-height: 44px; display: inline-flex; align-items: center; }
    .nav a:active, .themes button:active { color: var(--text); }
    /* The filled button dims instead of flipping colour: var(--text) on the azure
       ground would be navy-on-blue and unreadable in the light theme. */
    .talk:active { filter: brightness(0.94); }
  }
</style>
