---
import { nav, meta } from '../data/site.js';
---

<header class="site-header">
  <div class="site-header__inner route-wrap">
    <a class="site-brand" href="/" aria-label={`${meta.name} home`}>
      <svg viewBox="0 0 34 34" aria-hidden="true">
        <path d="M3 17h8l4-8 5 16 4-8h7" />
        <circle cx="3" cy="17" r="2" />
        <circle cx="31" cy="17" r="2" />
      </svg>
      <span>Client Optimal</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <div class="theme-switch" role="group" aria-label="Color theme">
        <button type="button" data-theme-set="light" aria-label="Use light theme" aria-pressed="true">Light</button>
        <button type="button" data-theme-set="dark" aria-label="Use dark theme" aria-pressed="false">Dark</button>
      </div>
      <a class="site-header__contact" href="/contact">Talk through a call <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--hair);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(18px);
  }
  .site-header__inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem;
  }
  .site-brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.68rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 720;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  .site-brand svg { width: 34px; color: var(--accent); }
  .site-brand path { fill: none; stroke: currentColor; stroke-width: 1.7; }
  .site-brand circle { fill: currentColor; }
  .site-nav { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2rem); }
  .site-nav a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--text-dim);
    font-size: 0.84rem;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }
  .site-nav a:hover, .site-nav a[aria-current="page"] { color: var(--accent); }
  .site-header__actions { display: flex; align-items: center; gap: 1rem; }
  .theme-switch { display: flex; gap: 0.1rem; padding: 0.2rem; border: 1px solid var(--hair); }
  .theme-switch button {
    min-height: 30px;
    padding-inline: 0.55rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }
  .theme-switch button[aria-pressed="true"] { background: var(--panel); color: var(--text); }
  .site-header__contact {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 0.65rem;
    padding: 0 0.85rem;
    border: 1px solid var(--accent-fill);
    background: var(--accent-fill);
    color: var(--accent-fill-ink);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }
  .site-header__contact span { font-size: 1rem; }
  @media (max-width: 980px) {
    .site-header__inner { flex-wrap: wrap; gap: 0 1rem; padding-block: 0.55rem; }
    .site-brand { margin-right: auto; }
    .site-nav { order: 3; width: 100%; overflow-x: auto; gap: 1.35rem; scrollbar-width: none; }
    .site-nav::-webkit-scrollbar { display: none; }
  }
  @media (max-width: 580px) {
    .site-header__inner { width: calc(100% - 1.5rem); }
    .site-header__actions { gap: 0.5rem; }
    .site-header__contact { padding-inline: 0.65rem; font-size: 0.7rem; }
    .theme-switch { display: none; }
    .site-nav { gap: 1.2rem; }
    .site-nav a { font-size: 0.78rem; }
  }
</style>
