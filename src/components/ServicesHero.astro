---
import { servicesHero } from '../data/site.js';
---

<section class="route-page-intro route-services-hero">
  <div class="route-wrap route-services-hero__grid">
    <div>
      <h1 class="route-page-title">A call route, built around your phone system.</h1>
      <div class="route-services-hero__actions">
        <a class="route-button" href={servicesHero.cta.href}>{servicesHero.cta.label}<span aria-hidden="true">↗</span></a>
        <a class="route-link" href={servicesHero.secondary.href}>{servicesHero.secondary.label}<span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="route-services-hero__aside">
      <p>{servicesHero.lead}</p>
      <span class="route-annotation">Scope / configure / test / support</span>
    </div>
  </div>
</section>

<style>
  .route-services-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr); align-items: end; gap: clamp(2.5rem, 8vw, 8rem); }
  .route-services-hero .route-page-title { max-width: 10ch; font-size: clamp(3.5rem, 8vw, 8rem); line-height: 0.9; letter-spacing: -0.065em; }
  .route-services-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 2rem; }
  .route-services-hero__aside { padding-top: 1rem; border-top: 2px solid var(--accent); }
  .route-services-hero__aside p { margin-bottom: 1.1rem; color: var(--text-dim); font-size: 1.05rem; line-height: 1.7; }
  @media (max-width: 760px) { .route-services-hero__grid { grid-template-columns: 1fr; } }
</style>
