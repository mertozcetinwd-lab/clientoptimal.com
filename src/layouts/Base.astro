---
// The site shell, redesigned 2026-10-21 to match /demo: white page, inset navy hero panels,
// condensed Archivo display type, Doto LED accents, light only (Mert's call). Each page opens with
// <PageHero> (which carries the nav); this layout supplies the head, the footer and the small
// scripts every page shares. The old dark/light theme switch and floating voice launcher are gone:
// the demo has its own page and every nav links to it.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/demo.css';
import '../styles/site.css';
import SiteFooter from '../components/site/SiteFooter.astro';
import { meta } from '../data/site.js';

interface Props { title?: string; description?: string; noindex?: boolean }
const {
  // Middle dot, not an em dash: a <title> is shipping copy like any other string.
  title = `${meta.name} · ${meta.tagline}`,
  description = meta.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Version the URL when the artwork changes so social scrapers refresh cached cards.
const ogImage = new URL('/og.png?v=20261014-voice-agent', Astro.site).href;

// One Organization node: every field is true and already lives in site.js.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: meta.name,
  legalName: meta.legalName,
  url: Astro.site?.href ?? canonical,
  description: meta.description,
  founder: { '@type': 'Person', name: meta.founder },
  sameAs: [
    'https://www.linkedin.com/company/client-optimal',
    'https://github.com/mertozcetinwd-lab',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#050f22" />
    <!-- Doto: a dot-matrix display face (OFL, Google Fonts) for the LED-sign accents. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Doto:wght@700;900&display=swap" rel="stylesheet" />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="d">
    <a class="d-skip" href="#main">Skip to content</a>
    <slot />
    <SiteFooter />

    <script>
      // Reveal on scroll and the cursor spotlight on cards. Both are additive: without JS, or with
      // reduced motion (demo.css), every section is simply visible.
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
      document.querySelectorAll<HTMLElement>('.d-order, .d-card').forEach((card) => {
        card.addEventListener('pointermove', (ev) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${ev.clientX - r.left}px`);
          card.style.setProperty('--my', `${ev.clientY - r.top}px`);
        });
      });
    </script>
  </body>
</html>
