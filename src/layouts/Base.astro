---
import '@fontsource-variable/archivo';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { meta } from '../data/site.js';

interface Props { title?: string; description?: string }
const {
  // Middle dot, not an em dash. references/voice.md in the parent AIOS rules
  // out em dashes, and a <title> is shipping copy like any other string.
  title = `${meta.name} · ${meta.tagline}`,
  description = meta.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Absolute URL for the social card image. Social scrapers reject relative paths.
const ogImage = new URL('/og.png', Astro.site).href;

// Organization structured data. A small static business site gets nothing from a
// framework of schema, but a single Organization node helps search engines
// attach the brand, the founder, and the real social profiles together. Every
// field is true and already lives in site.js — nothing invented.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: meta.name,
  legalName: meta.legalName,
  url: Astro.site?.href ?? canonical,
  description: meta.description,
  founder: { '@type': 'Person', name: meta.founder },
  sameAs: [
    'https://www.linkedin.com/company/client-optimal',
    'https://github.com/mertozcetinwd-lab',
  ],
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline>
      // Runs before first paint, and both jobs depend on that.
      // data-theme: settle it here or the page flashes the wrong field.
      // .js: tokens.css hides .reveal ONLY under html.js, so a JS failure
      // leaves every section visible instead of blank.
      (function () {
        var el = document.documentElement;
        el.classList.add('js');
        var t;
        try {
          // ?theme= wins over the stored preference. It exists so a headless
          // browser can shoot both themes without touching localStorage, which
          // is how this site gets visually verified. Same trick as the sibling.
          var p = new URLSearchParams(location.search).get('theme');
          t = p || localStorage.getItem('co-theme');
        } catch (e) {}
        if (t === 'dark' || t === 'light') el.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      import { initThemeControls } from '../scripts/theme.js';
      import { initReveals } from '../scripts/reveal.js';
      initThemeControls();
      initReveals();

      // Restrained CRT nod: one quick scanline sweep when the colour mode flips.
      // Fires only on the theme engine's `themechange` event, so it never runs on
      // load or scroll. The class self-removes after the 220ms animation.
      let glitchT;
      window.addEventListener('themechange', () => {
        const root = document.documentElement;
        root.classList.add('theme-glitch');
        clearTimeout(glitchT);
        glitchT = setTimeout(() => root.classList.remove('theme-glitch'), 240);
      });
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed; top: -120px; left: 0; z-index: 200;
    background: var(--text); color: var(--bg);
    padding: 0.7em 1.1em;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em;
    text-decoration: none;
    transition: top 0.2s var(--ease);
  }
  .skip:focus { top: 0; }
</style>
