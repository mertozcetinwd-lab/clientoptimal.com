---
// Legal and contact pages (privacy, terms, contact), restyled 2026-10-21 into the new site design.
// Only the presentation changed: the wording in each page is untouched, because carriers and the
// 10DLC brand registration check it.
import Base from './Base.astro';
import PageHero from '../components/site/PageHero.astro';
import { meta } from '../data/site.js';

interface Props { title: string; kicker: string; updated?: string; effective?: string }
const { title, kicker, updated, effective = meta.effectiveDate } = Astro.props;
---

<Base title={`${title} · ${meta.name}`} description={kicker}>
  <PageHero size="compact">
    <div class="d-wrap">
      <div class="d-page-head" id="main">
        <p class="d-pill d-in d-in--1">{meta.legalName}</p>
        <h1 class="d-display d-in d-in--2">{title}</h1>
        <p class="d-lede d-in d-in--3">{kicker}</p>
        <p class="d-date d-in d-in--4">Effective {effective}{updated && ` · Updated ${updated}`}</p>
      </div>
    </div>
  </PageHero>
  <main class="d-legal">
    <div class="d-wrap"><div class="prose"><slot /></div></div>
  </main>
</Base>
