{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clientoptimal-com",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "routes": [
    { "pattern": "clientoptimal.com", "custom_domain": true },
    { "pattern": "www.clientoptimal.com", "custom_domain": true },
    { "pattern": "try.clientoptimal.com", "custom_domain": true },
    { "pattern": "clientoptimalvoice.com/*", "zone_name": "clientoptimalvoice.com" },
    { "pattern": "www.clientoptimalvoice.com/*", "zone_name": "clientoptimalvoice.com" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
